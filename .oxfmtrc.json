{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "services/kilo-mcp/catalog.json",
    "services/*/container/plugin/*",
    "services/*/plugins/*/src/*",
    "apps/web/src/app/(app)/*/*/merges/*"
  ]
}
