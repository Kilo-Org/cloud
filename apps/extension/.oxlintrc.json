{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error"
  },
  "rules": {
    "eslint/func-style": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-statements": "off",
    "eslint/no-duplicate-imports": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/no-ternary": "off",
    "eslint/no-void": "off",
    "eslint/sort-imports": "off",
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/no-default-export": "off",
    "import/no-named-export": "off",
    "import/no-unassigned-import": "off",
    "import/prefer-default-export": "off",
    "react/jsx-filename-extension": "off",
    "react/jsx-max-depth": "off",
    "react/jsx-no-literals": "off",
    "react/only-export-components": "off",
    "react/react-in-jsx-scope": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/strict-void-return": "off",
    "unicorn/no-null": "off",
    "vitest/no-importing-vitest-globals": "off",
    "vitest/prefer-to-be-falsy": "off",
    "vitest/prefer-to-be-truthy": "off",
    "vitest/require-hook": "off",
    "vitest/require-test-timeout": "off",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-unknown-returns": "error",
    "zod-utils/no-inline-zod-schema": "error",

    // oxlint 1.88 implements many of the rules the categories above select and
    // tightens detection in others, so this upgrade alone reports about 8,000
    // findings. They stay off until each rule is adopted on its own, with its
    // findings fixed in a change that can review them.
    "import/newline-after-import": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "no-multi-assign": "off",
    "no-underscore-dangle": "off",
    "object-shorthand": "off",
    "one-var": "off",
    "prefer-named-capture-group": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/function-component-definition": "off",
    "react/incompatible-library": "off",
    "react/memo-dependencies": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "require-unicode-regexp": "off",
    "typescript/consistent-return": "off",
    "typescript/dot-notation": "off",
    "typescript/method-signature-style": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/prefer-regexp-exec": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/custom-error-definition": "off",
    "unicorn/max-nested-calls": "off",
    "unicorn/prefer-export-from": "off",
    "unicorn/prefer-import-meta-properties": "off",
    "unicorn/prefer-number-coercion": "off",
    "unicorn/prefer-single-call": "off",
    "vitest/prefer-expect-assertions": "off",
    "vitest/prefer-importing-vitest-globals": "off",
    "vitest/prefer-strict-boolean-matchers": "off",
    "vitest/require-mock-type-parameters": "off"
  },
  "env": {
    "browser": true,
    "builtin": true,
    "node": true
  },
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "../../tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "zod-utils",
      "specifier": "../../tools/oxlint/zod-utils.mjs"
    }
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "tests/**", "scripts/**"],
      "rules": {
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-object-parameters": "off",
        "anti-slop/no-reflect-apply": "off",
        "anti-slop/no-reflect-get": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-returns": "off",
        "zod-utils/no-inline-zod-schema": "off"
      }
    }
  ]
}
