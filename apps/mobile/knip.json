{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/glanceable-android/register.ts",
    "src/lib/chat/remote-mcp-pkce.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  // The name tables are generated and read through `require`, which knip cannot
  // follow, so every one of their exports reads as unused. One generator run
  // rewrites the whole directory; see scripts/generate-language-search-names.mjs.
  "ignoreIssues": {
    "src/i18n/language-search-name-tables/*.ts": ["exports", "files"]
  },
  "ignoreDependencies": [
    "@expo/plist",
    "expo-updates",
    "expo-system-ui",
    "react-native-android-widget",
    "postcss",
    "@sentry/cli"
  ],
  "ignoreBinaries": ["oxfmt", "oxlint"],
  "postcss": {
    "config": ["postcss.config.mjs"]
  },
  "babel": {
    "config": ["babel.config.js"]
  },
  "rules": {
    "catalogReferences": "off"
  }
}
