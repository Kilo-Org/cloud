<?xml version="1.0" encoding="utf-8"?>
<!--
  The App Actions capability declaration for the four app actions.

  Each capability names the same custom intent action the exported entry point
  in AndroidManifest.xml answers, so the Assistant, the launcher and another app
  all reach one implementation. Surfacing these in the Assistant additionally
  needs the capability configuration in the Play Console: this file is the app's
  own declaration, not the store-side configuration.

  Nothing here carries action logic. A capability names an entry point; the
  entry point hands the request to the shared JS dispatcher.
-->
<actions xmlns:android="http://schemas.android.com/apk/res/android">
  <capability android:name="com.kilocode.kiloapp.action.START_AGENT">
    <intent
      android:action="com.kilocode.kiloapp.action.START_AGENT"
      android:targetPackage="com.kilocode.kiloapp"
      android:targetClass="expo.modules.kiloappactions.KiloActionActivity" />
  </capability>

  <capability android:name="com.kilocode.kiloapp.action.OPEN_NEEDS_INPUT">
    <intent
      android:action="com.kilocode.kiloapp.action.OPEN_NEEDS_INPUT"
      android:targetPackage="com.kilocode.kiloapp"
      android:targetClass="expo.modules.kiloappactions.KiloActionActivity" />
  </capability>

  <capability android:name="com.kilocode.kiloapp.action.OPEN_SESSION">
    <intent
      android:action="com.kilocode.kiloapp.action.OPEN_SESSION"
      android:targetPackage="com.kilocode.kiloapp"
      android:targetClass="expo.modules.kiloappactions.KiloActionActivity" />
  </capability>

  <capability android:name="com.kilocode.kiloapp.action.OPEN_PULL_REQUEST">
    <intent
      android:action="com.kilocode.kiloapp.action.OPEN_PULL_REQUEST"
      android:targetPackage="com.kilocode.kiloapp"
      android:targetClass="expo.modules.kiloappactions.KiloActionActivity" />
  </capability>
</actions>
