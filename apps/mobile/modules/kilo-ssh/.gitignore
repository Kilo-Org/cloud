# Built by scripts/build-android.sh and scripts/build-ios.sh, never committed.
/rust/target/
/android/src/main/jniLibs/
/android/src/main/java/ai/kilo/reactnativessh/uniffi/
/ios/Generated/
/ios/Frameworks/

# The root and app ignore lists drop *.pem as key material. These are committed
# test keys the Rust suites read, and the suites fail without them.
!/rust/ssh-core/tests/fixtures/*.pem