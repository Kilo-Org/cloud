Port 2222
AddressFamily inet
ListenAddress 0.0.0.0

HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_rsa_key

PidFile /run/sshd.password.pid
PasswordAuthentication yes
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
UsePAM yes

# An idle client must send keepalives to stay connected: the tests rely on this
# to tell a session that keeps itself alive from one that does not.
ClientAliveInterval 5
ClientAliveCountMax 1

PrintMotd no
AcceptEnv LANG LC_*
Subsystem sftp internal-sftp

# Port forwarding fixtures: the bastion role tunnels to a host only it can
# reach, and the remote-forward role binds a port the test reaches from the
# host through a published container port.
AllowTcpForwarding yes
GatewayPorts clientspecified
PermitOpen any
