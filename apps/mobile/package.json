{
  "name": "kilo-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "pnpx eas-cli@24.8.0 build --profile development",
    "build:ios": "pnpx eas-cli@24.8.0 build -p ios --profile development",
    "build:android": "pnpx eas-cli@24.8.0 build -p android --profile development",
    "release:internal": "pnpx eas-cli@24.8.0 build --profile production --auto-submit",
    "release:internal:ios": "pnpx eas-cli@24.8.0 build -p ios --profile production --auto-submit",
    "release:internal:android": "pnpx eas-cli@24.8.0 build -p android --profile production --auto-submit",
    "assert:config": "node scripts/assert-expo-config.mjs",
    "eas-build-post-install": "pnpm --filter @kilocode/harness-sdk run build",
    "typecheck": "tsgo --noEmit",
    "lint": "pnpm -w exec oxlint --config apps/mobile/.oxlintrc.json apps/mobile/src",
    "format": "oxfmt src",
    "format:check": "oxfmt --list-different src",
    "check:unused": "node --env-file=.env node_modules/knip/bin/knip.js --no-config-hints",
    "check:i18n": "pnpm -w exec oxlint --config apps/mobile/.oxlintrc.i18n.json apps/mobile/src packages/app-shared/src && node ../../tools/i18n/check-catalogs.mjs",
    "check:plurals": "node ../../tools/i18n/check-plurals.mjs --source-only",
    "check:classes": "node ../../tools/nativewind/check-classes.mjs",
    "test": "node scripts/assert-theme-colors.mjs && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bsky.app/react-native-uitextview": "2.7.1",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@expo/app-integrity": "~58.0.2",
    "@expo/react-native-action-sheet": "4.1.1",
    "@expo/ui": "~58.0.17",
    "@formatjs/intl-durationformat": "^0.11.1",
    "@formatjs/intl-listformat": "^8.3.15",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-numberformat": "^9.4.3",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@formatjs/intl-relativetimeformat": "^12.3.15",
    "@formatjs/intl-segmenter": "^12.2.15",
    "@kilocode/app-shared": "workspace:*",
    "@kilocode/cloud-agent-sdk": "workspace:*",
    "@kilocode/event-service": "workspace:*",
    "@kilocode/harness-sdk": "workspace:*",
    "@kilocode/kilo-chat": "workspace:*",
    "@kilocode/kilo-chat-hooks": "workspace:*",
    "@kilocode/notifications": "workspace:*",
    "@kilocode/session-ingest-contracts": "workspace:*",
    "@kilocode/trpc": "workspace:*",
    "@native-html/render": "1.0.3",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "16.1.5",
