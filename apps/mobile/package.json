  "devDependencies": {
    "@expo/plist": "0.10.1",
    "@sentry/cli": "catalog:",
    "@types/react": "~19.3.0",
    "@typescript/native-preview": "catalog:",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~58.0.14",
    "drizzle-kit": "catalog:",
    "eslint-plugin-sonarjs": "4.2.2",
    "knip": "6.41.0",
    "postcss": "8.5.30",
    "test-renderer": "1.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:vitest5"
  },
  "dependenciesMeta": {
    "@kilocode/kilo-chat-hooks": {
      "injected": true
    }
  },
  "enriched-markdown": {
    "enableMath": false,
    "enableVideo": false
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-ui",
          "expo-background-task",
          "expo-notifications",
          "expo-task-manager",
          "unimodules-app-loader"
        ]
      }
    },
    "install": {
      "exclude": [
        "@sentry/react-native",
        "@shopify/flash-list",
        "react-native-keyboard-controller",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "private": true
}
