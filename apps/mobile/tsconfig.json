{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    // app.config.ts imports src/i18n/languages.ts with its extension: the Expo
    // config loader resolves require('./x.ts') but not the extensionless form.
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      // react-test-renderer is removed; the test harness renders with the
      // maintained `test-renderer` through src/test/renderer. A test that still
      // names the old package for its DOM-free instance type resolves here.
      "react-test-renderer": ["./src/test/renderer"]
    }
  },
  // src/lib/env-keys.js and src/lib/android-notification-channels.js carry
  // @ts-check JSDoc contracts (env keys, silent Android channels) read by
  // app.config.ts and scripts/assert-expo-config.mjs. Explicitly listed so the
  // check does not depend on some .ts file happening to import them.
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/lib/env-keys.js",
    "src/lib/android-notification-channels.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
