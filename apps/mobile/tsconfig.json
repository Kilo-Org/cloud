{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // app.config.ts imports src/i18n/languages.ts with its extension: the Expo
    // config loader resolves require('./x.ts') but not the extensionless form.
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      // react-test-renderer is removed; the test harness renders with the
      // maintained `test-renderer` through src/test/renderer. A test that still
      // names the old package for its DOM-free instance type resolves here.
      "react-test-renderer": ["./src/test/renderer"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
