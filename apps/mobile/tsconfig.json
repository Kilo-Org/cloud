{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    // app.config.ts imports src/i18n/languages.ts with its extension: the Expo
    // config loader resolves require('./x.ts') but not the extensionless form.
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  // src/lib/env-keys.js, src/lib/android-notification-channels.js and
  // src/lib/permission-prompt-plist-keys.js carry @ts-check JSDoc contracts
  // (env keys, silent Android channels, iOS permission-prompt plist keys) read
  // by app.config.ts and scripts/assert-expo-config.mjs. Explicitly listed so
  // the check does not depend on some .ts file happening to import them.
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/lib/env-keys.js",
    "src/lib/android-notification-channels.js",
    "src/lib/permission-prompt-plist-keys.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
