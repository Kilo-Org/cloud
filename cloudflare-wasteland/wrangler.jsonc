{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wasteland",
  "main": "src/wasteland.worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "upload_source_maps": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [
    {
      "pattern": "wasteland.kiloapps.io/*",
      "zone_name": "kiloapps.io",
    },
  ],
  "workers_dev": false,

  "containers": [
    {
      "class_name": "WastelandContainerDO",
      "image": "./container/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 200,
    },
  ],

  "durable_objects": {
    "bindings": [
      { "name": "WASTELAND", "class_name": "WastelandDO" },
      { "name": "WASTELAND_CONTAINER", "class_name": "WastelandContainerDO" },
    ],
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WastelandDO",
        "WastelandContainerDO",
      ],
    },
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "KILO_API_URL": "https://api.kilo.ai",
    "WASTELAND_API_URL": "https://wasteland.kiloapps.io",
  },

  "analytics_engine_datasets": [{ "binding": "WASTELAND_AE", "dataset": "wasteland_events" }],

  // PRODUCTION Secrets Store (shared Kilo secrets store)
  "secrets_store_secrets": [
    {
      "binding": "WASTELAND_JWT_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "WASTELAND_JWT_SECRET_PROD",
    },
    {
      "binding": "NEXTAUTH_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "NEXTAUTH_SECRET",
    },
  ],

  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "development",
        // Wrangler's workerd-network doesn't get Docker Desktop's
        // host.docker.internal → host proxy mapping. Use the Docker
        // Desktop VM host gateway IP directly so containers can reach
        // the host's dev servers.
        "KILO_API_URL": "http://192.168.65.254:3000",
        "WASTELAND_API_URL": "http://192.168.65.254:8787",
      },
      "containers": [
        {
          "name": "wasteland-dev-WastelandContainerDO",
          "class_name": "WastelandContainerDO",
          "image": "./container/Dockerfile.dev",
          "instance_type": "standard-2",
          "max_instances": 50,
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "WASTELAND", "class_name": "WastelandDO" },
          { "name": "WASTELAND_CONTAINER", "class_name": "WastelandContainerDO" },
        ],
      },
      "analytics_engine_datasets": [{ "binding": "WASTELAND_AE", "dataset": "wasteland_events" }],
      "secrets_store_secrets": [
        {
          "binding": "WASTELAND_JWT_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "WASTELAND_JWT_SECRET_PROD",
        },
        {
          "binding": "NEXTAUTH_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "NEXTAUTH_SECRET",
        },
      ],
    },
  },
}
