{
  "name": "kilocode-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "bash scripts/prepare.sh",
    "preinstall": "node scripts/check-pnpm.mjs",
    "typecheck": "scripts/typecheck-all.sh",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter web test && pnpm run test:scripts",
    "test:scripts": "pnpm run test:web-rewrites && pnpm run test:web-env && pnpm run test:dev-local && pnpm run test:oxlint-plugins && pnpm run test:mobile-artifacts && pnpm run test:mobile-sbom && pnpm run test:kilo-app-release && pnpm run test:kilo-mcp-release && pnpm run test:kilo-extension-release && pnpm run test:validate && pnpm run test:secrets-migration",
    "test:web-rewrites": "node --test apps/web/ai-gateway-rewrites.test.mjs",
    "test:web-env": "tsx --tsconfig scripts/web-env/tsconfig.json --test scripts/web-env/*.test.ts",
    "test:oxlint-plugins": "tsx --test tools/oxlint/anti-slop/test/*.test.ts",
    "test:setup-smoke": "pnpm --filter web run test:setup-smoke",
    "test:mobile-artifacts": "node --test scripts/inspect-mobile-artifacts.test.mjs",
    "test:mobile-sbom": "node --test scripts/mobile-sbom.test.mjs scripts/mobile-sbom-cyclonedx.test.mjs scripts/mobile-sbom-pnpm.test.mjs scripts/mobile-sbom-ipa.test.mjs scripts/mobile-sbom-aab.test.mjs",
    "test:kilo-app-release": "node --test scripts/kilo-app-release.test.mjs",
    "test:kilo-mcp-release": "node --test scripts/kilo-mcp-release.test.mjs",
    "test:kilo-extension-release": "node --test 'scripts/kilo-extension-*.test.mjs'",
    "test:validate": "node --test scripts/validate.test.mjs",
    "test:secrets-migration": "tsx --test 'scripts/secrets-migration/runtime-copy/*.test.mjs'",
    "lint": "scripts/lint-all.sh",
    "lint:workflows": "scripts/zizmor.sh",
    "format": "oxfmt",
    "format:check": "oxfmt --list-different .",
    "format:changed": "bash scripts/format-changed.sh",
    "check:md-table-padding": "tsx script/check-md-table-padding.ts",
    "validate": "node scripts/validate.mjs",
    "drizzle": "pnpm --filter @kilocode/db exec drizzle-kit",
    "drizzle:verify-bootstrap": "bash scripts/verify-drizzle-bootstrap.sh",
    "test:e2e": "pnpm --filter web run test:e2e",
    "web:dependency-cycle-check": "pnpm --filter web run dependency-cycle-check",
    "dependency-cycle-check": "pnpm run web:dependency-cycle-check",
    "dev:worktree:prepare": "bash scripts/worktree-prepare.sh",
    "test:db": "pnpm -s dev:infra-env && docker compose -f dev/docker-compose.yml up -d --wait postgres && pnpm drizzle migrate",
    "dev:db:reset": "pnpm --filter web db:empty-database",
    "dev:start": "tsx dev/local/cli.ts up",
    "dev:stop": "tsx dev/local/cli.ts stop",
    "dev:status": "tsx dev/local/cli.ts status",
    "dev:restart": "tsx dev/local/cli.ts restart",
    "dev:start-command": "tsx dev/local/cli.ts start-command",
    "dev:capture": "tsx dev/local/cli.ts capture",
    "dev:env": "tsx dev/local/cli.ts env",
    "dev:infra-env": "tsx dev/local/infra-env.ts",
    "dev:env:mobile": "tsx dev/local/mobile-env.ts",
    "dev:mock-github": "tsx dev/mock-github/server.ts",
    "dev:mock-anthropic": "tsx dev/mock-anthropic/server.ts",
    "dev:mock-snowflake": "tsx dev/mock-snowflake/server.ts",
    "dev:byok-kms": "tsx dev/byok-kms/server.ts",
    "dev:mobile:android": "tsx dev/local/mobile-android.ts",
    "dev:mobile:ios": "tsx dev/local/mobile-ios-build.ts",
    "dev:mobile:design-gate": "tsx dev/local/design-gate/cli.ts",
    "dev:pixel-diff": "tsx dev/local/pixel-diff/compare-pair.ts",
    "test:dev-local": "tsx --test 'dev/**/*.test.ts'",
    "dev:setup-env": "tsx dev/local/setup-env.ts",
    "dev:seed": "tsx dev/seed/index.ts",
    "dev:discord-gateway-cron": "tsx dev/discord-gateway-cron.ts",
    "dev:kiloclaw-fly-instances": "tsx services/kiloclaw/scripts/dev-fly-instances.ts",
    "web:env": "tsx scripts/web-env/index.ts",
    "dev:mobile:diagnostics": "tsx dev/local/mobile-diagnostics.ts"
  },
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@expo/agent-cli": "1.0.22",
    "@expo/fingerprint": "~0.21.5",
    "@kilocode/db": "workspace:*",
    "@kilocode/app-shared": "workspace:*",
    "@kilocode/session-ingest-contracts": "workspace:*",
    "@kilocode/worker-utils": "workspace:*",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "catalog:",
    "@types/pngjs": "6.0.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.14",
    "@typescript/native-preview": "catalog:",
    "aws4fetch": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint-plugin-zod-utils": "1.0.11",
    "husky": "9.1.7",
    "ink": "6.8.0",
    "js-yaml": "catalog:",
    "oxc-parser": "0.157.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-react-native": "0.2.38",
    "oxlint-tsgolint": "7.0.2006",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "proper-lockfile": "4.1.2",
    "react": "19.2.6",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vercel": "53.3.1",
    "zod": "catalog:"
  }
}
