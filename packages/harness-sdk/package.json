{
  "name": "@kilocode/harness-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./plugins/gateway": "./src/plugins/gateway/index.ts",
    "./plugins/id": "./src/plugins/id/ulid.ts",
    "./plugins/prompt": "./src/plugins/prompt/default.ts"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "lint": "pnpm -w exec oxlint --config packages/harness-sdk/.oxlintrc.json packages/harness-sdk/src",
    "check:boundaries": "! grep -rln \"plugins/\" src/core --include='*.ts' | grep -v '\\.test\\.ts$'",
    "check": "pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm test"
  },
  "dependencies": {
    "effect": "3.22.1",
    "ulid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
