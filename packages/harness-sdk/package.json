{
  "name": "@kilocode/harness-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./plugins/gateway": "./dist/plugins/gateway/index.js",
    "./plugins/prompt": "./dist/plugins/prompt/default.js"
  },
  "scripts": {
    "build": "rm -rf dist && ttsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm typecheck:e2e && pnpm lint && pnpm check:boundaries && pnpm test && pnpm build",
    "check:boundaries": "! grep -rln \"plugins/\" src/core --include='*.ts' | grep -v '\\.test\\.ts$'",
    "lint": "pnpm -w exec oxlint --config packages/harness-sdk/.oxlintrc.json packages/harness-sdk/src",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "ttsx e2e/live.ts",
    "test:e2e:models": "ttsx e2e/models.ts",
    "test:watch": "vitest",
    "typecheck": "ttsc --noEmit",
    "typecheck:e2e": "ttsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.104.1",
    "effect": "3.22.1",
    "eventsource-parser": "3.0.8",
    "openai": "6.49.0",
    "typia": "14.0.4",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@ttsc/unplugin": "0.28.3",
    "@types/node": "catalog:",
    "ttsc": "0.28.3",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
