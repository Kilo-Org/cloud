{
  "name": "@kilocode/harness-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./plugins/gateway": "./dist/plugins/gateway/index.js",
    "./plugins/prompt": "./dist/plugins/prompt/default.js",
    "./plugins/store/node": "./dist/plugins/store/node.js",
    "./plugins/store/expo": "./dist/plugins/store/expo.js"
  },
  "scripts": {
    "build": "rm -rf dist && ttsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm typecheck:e2e && pnpm lint && pnpm check:boundaries && pnpm check:migrations && pnpm test && pnpm test:perf && pnpm build",
    "check:migrations": "ttsx --project scripts/tsconfig.json scripts/check-migrations.ts",
    "check:boundaries": "! grep -rln \"plugins/\" src/core --include='*.ts' | grep -v -e '\\.test\\.ts$' -e '\\-fixture\\.ts$'",
    "lint": "pnpm -w exec oxlint --config packages/harness-sdk/.oxlintrc.json packages/harness-sdk/src",
    "migrations": "drizzle-kit generate && ttsx --project scripts/tsconfig.json scripts/inline-migrations.ts && pnpm -w exec oxfmt packages/harness-sdk/src/plugins/store/migrations.ts",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "ttsx e2e/live.ts",
    "test:e2e:cancel": "ttsx e2e/cancel.ts",
    "test:e2e:compact": "ttsx e2e/compact.ts",
    "test:e2e:image": "ttsx e2e/image.ts",
    "test:e2e:models": "ttsx e2e/models.ts",
    "test:e2e:probe": "ttsx e2e/probe.ts",
    "test:e2e:reasoning": "ttsx e2e/reasoning.ts",
    "test:e2e:session": "ttsx e2e/session.ts",
    "test:e2e:shapes": "ttsx e2e/shapes.ts",
    "test:e2e:stop": "ttsx e2e/stop.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:watch": "vitest",
    "typecheck": "ttsc --noEmit",
    "typecheck:e2e": "ttsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.104.1",
    "drizzle-orm": "catalog:",
    "effect": "3.22.1",
    "eventsource-parser": "3.0.8",
    "openai": "6.49.0",
    "typia": "14.0.4"
  },
  "devDependencies": {
    "@ttsc/unplugin": "0.28.3",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "expo-sqlite": "~57.0.1",
    "ttsc": "0.28.3",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
