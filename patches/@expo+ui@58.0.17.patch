+  let onTap: () -> Void
+
+  func makeCoordinator() -> Coordinator {
+    Coordinator()
+  }
+
+  func makeUIView(context: Context) -> ReportingView {
+    let view = ReportingView()
+    view.reporter = context.coordinator
