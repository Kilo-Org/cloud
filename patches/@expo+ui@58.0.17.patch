+  }
+
+  func updateUIView(_ uiView: ReportingView, context: Context) {
+    context.coordinator.enabled = enabled
+    context.coordinator.onTap = onTap
+    context.coordinator.contentView = uiView
+    context.coordinator.refresh()
+  }
