+        // Reading a shared file runs on the main thread inside onNewIntent, so
+        // any provider failure (no metadata, no permission, no mime type) would
+        // crash the app. Send it to JS as a share error instead.
+        private fun notifyFileShare(uris: List<Uri>) {
+            val files = try {
+                uris.map { getFileInfo(it) }
+            } catch (e: Exception) {
+                notifyError("Cannot read shared file: ${e.message}")
+                return
+            }
+            notifyShareIntent(mapOf("files" to files, "type" to "file"))
