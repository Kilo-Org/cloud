+
+/// The app language's layout direction, not the device's. The app can run in a
+/// language other than the device's, and the extension would otherwise lay the
+/// card out in the device language around copy baked in the app language. The
+/// app writes its language to the shared app group as `homeWidgetLocale`
+/// (repo-local: `HomeWidgetRefreshStore.layoutDirection` reads the same key the
+/// same way for the Home widget).
+private func appLayoutDirection() -> LayoutDirection {
+  let locale = WidgetsStorage.defaults?.string(forKey: "homeWidgetLocale") ?? Locale.current.identifier
+  let language = locale.replacingOccurrences(of: "_", with: "-").split(separator: "-").first.map(String.init) ?? "en"
+  return Locale.characterDirection(forLanguage: language) == .rightToLeft ? .rightToLeft : .leftToRight
 }
 
