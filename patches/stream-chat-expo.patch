+const getVideoThumbnail = async (uri: string, durationSec: number) => {
+  if (!createVideoPlayer) return undefined;
+  const player = createVideoPlayer(uri);
+  try {
+    // Use 1s into the video to avoid blank first frames; fall back to 0 for very short clips
+    const time = durationSec > 1 ? 1 : 0;
+    const [thumbnail] = await player.generateThumbnailsAsync([time]);
+    return thumbnail;
+  } catch {
+    return undefined;
+  } finally {
+    player.release();
+  }
