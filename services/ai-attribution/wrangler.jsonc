{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kilo-ai-attribution",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "workers_dev": false,
  "main": "src/ai-attribution.worker.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "ATTRIBUTION_TRACK_ORG_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 6000,
        "period": 60,
      },
    },
    {
      "name": "ATTRIBUTION_TRACK_USER_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": {
        "limit": 600,
        "period": 60,
      },
    },
  ],
  "dev": { "port": 8787 },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],
  "logpush": true,
  // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
  // (services/sts/test/repo/worker-configs.ts).
  "observability": {
    "enabled": true,
    "traces": { "enabled": false },
  },
  "vars": {
    "ENVIRONMENT": "production",
    // Where every runtime secret read goes: `env` (the Secrets Store binding below) or `sts` (the
    // bundle over the `STS` binding). An absent value means `env`; any other value refuses every
    // read. The `sts` source never falls back to the Secrets Store.
    "SECRETS_SOURCE": "env",
  },
  "services": [
    // STS serves the runtime secret bundle over the account-internal binding. `props.caller` is
    // what STS authorizes on and must equal this Worker's top-level name; services/sts/policy/
    // kilo-ai-attribution.yaml grants NEXTAUTH_SECRET and ADMIN_SECRET. Nothing reads it while
    // SECRETS_SOURCE is `env`.
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "kilo-ai-attribution" },
    },
  ],
  "routes": [
    {
      "pattern": "ai-attribution.kiloapps.io/*",
      "zone_name": "kiloapps.io",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ATTRIBUTION_TRACKER",
        "class_name": "AttributionTrackerDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AttributionTrackerDO"],
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "NEXTAUTH_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "NEXTAUTH_SECRET_PROD",
    },
    {
      "binding": "ADMIN_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "AI_ATTRIBUTION_ADMIN_SECRET_PROD",
    },
  ],
  "env": {
    "dev": {
      // Fence: named envs inherit top-level routes; never publish dev to prod hosts.
      "routes": [],
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": [] },
      "vars": {
        "ENVIRONMENT": "development",
      },
      "secrets_store_secrets": [
        {
          "binding": "NEXTAUTH_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "NEXTAUTH_SECRET_DEV",
        },
        {
          "binding": "ADMIN_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "AI_ATTRIBUTION_ADMIN_SECRET_DEV",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ATTRIBUTION_TRACKER",
            "class_name": "AttributionTrackerDO",
          },
        ],
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "local-only",
          "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
        },
      ],
      "ratelimits": [
        {
          "name": "ATTRIBUTION_TRACK_ORG_RATE_LIMITER",
          "namespace_id": "1006",
          "simple": {
            "limit": 6000,
            "period": 60,
          },
        },
        {
          "name": "ATTRIBUTION_TRACK_USER_RATE_LIMITER",
          "namespace_id": "1008",
          "simple": {
            "limit": 600,
            "period": 60,
          },
        },
      ],
    },
  },
}
