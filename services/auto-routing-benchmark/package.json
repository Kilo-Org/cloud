{
  "name": "auto-routing-benchmark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "node scripts/deploy.mjs",
    "predev": "CI=1 wrangler d1 migrations apply auto-routing-benchmark --local",
    "dev": "wrangler dev",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "typecheck": "tsgo --noEmit",
    "lint": "pnpm -w exec oxlint --config .oxlintrc.json services/auto-routing-benchmark/src",
    "db:generate": "drizzle-kit generate",
    "scoreboard": "tsx scripts/scoreboard.ts",
    "scoreboard:prod": "tsx scripts/scoreboard-prod.ts",
    "judge:calibrate": "tsx scripts/judge-calibration.ts",
    "sweep:offline": "tsx scripts/offline-sweep.ts",
    "screen:candidates": "tsx scripts/screen-candidates.ts",
    "smoke:scheduler": "tsx scripts/scheduler-smoke.ts",
    "test": "vitest run && pnpm run test:deploy && pnpm run test:python",
    "test:python": "python3 -m venv /tmp/kilo-study-venv && /tmp/kilo-study-venv/bin/pip install --quiet -r repo-study/requirements.txt && cd scripts && /tmp/kilo-study-venv/bin/python -m unittest test_router_ledger test_router_study test_router_proof && cd ../repo-study && /tmp/kilo-study-venv/bin/python -m unittest test_text_tariffs",
    "test:deploy": "tsx --test scripts/deploy.test.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "0.1.1",
    "@kilocode/auto-routing-contracts": "workspace:*",
    "@kilocode/usage-contracts": "workspace:*",
    "@kilocode/worker-utils": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "catalog:",
    "jsonc-parser": "3.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:vitest5",
    "wrangler": "catalog:"
  }
}
