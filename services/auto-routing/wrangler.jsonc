{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "name": "auto-routing",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": true,
  "routes": [
    {
      "pattern": "auto-routing.kiloapps.io",
      "zone_name": "kiloapps.io",
      "custom_domain": true,
    },
  ],
  "dev": {
    "port": 8810,
    "local_protocol": "http",
    "ip": "0.0.0.0",
  },
  // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
  // (services/sts/test/repo/worker-configs.ts).
  "observability": {
    "enabled": true,
    "traces": { "enabled": false },
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],
  // `INTERNAL_CREDENTIAL_ACCEPT` is unset here, which means `legacy-only`: `/admin/*` and
  // `POST /decide` accept only `Authorization: Bearer <INTERNAL_API_SECRET>`, exactly as before
  // (src/auth.ts). Accepting STS service tokens needs the `auto-routing` scopes granted in STS
  // policy (they are registered in @kilocode/sts-contracts), then a separate change that sets it
  // (`legacy-and-sts`, later `sts-only`) and `STS_ENVIRONMENT` `production`. Rollback is a
  // redeploy with it unset or `legacy-only`.
  "vars": {
    "O11Y_CF_ACCOUNT_ID": "e115e769bcdd4c3d66af59d3332cb394",
    "KILO_WEB_API_BASE_URL": "https://app.kilo.ai",
    // `WEB_INTERNAL_AUTH` (decision D59) is unset, so the classifier's usage writes to
    // `/api/internal/usage/record` send `INTERNAL_API_SECRET_PROD` as `x-internal-api-key`.
    // `"sts"` sends a `web:usage.classifier.record` STS service token over the `STS` binding
    // instead; set it only once the Worker has that binding, STS grants the scope and the route
    // accepts STS. Removing it is the rollback.
    "KILO_AI_GATEWAY_BASE_URL": "https://ai-gateway.kilo.ai",
    // Where every runtime secret read goes: `secrets-store` (the Secrets Store binding below) or
    // `sts` (the bundle over the `STS` binding). An absent value means `secrets-store`; any other
    // value refuses every read. The `sts` source never falls back to the Secrets Store.
    "SECRETS_SOURCE": "secrets-store",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTO_ROUTING_DECISION_CACHE",
        "class_name": "AutoRoutingDecisionCacheDO",
      },
      {
        "name": "AUTO_ROUTING_MODE_CONFIG",
        "class_name": "AutoRoutingModeConfigDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AutoRoutingDecisionCacheDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AutoRoutingModeConfigDO"],
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "AUTO_ROUTING_CLASSIFIER_METRICS_V2",
      "dataset": "auto_routing_classifier_metrics_v2",
    },
  ],
  // STS serves the runtime secret bundle over the account-internal binding. `props.caller` is
  // what STS authorizes on and must equal this Worker's top-level name; services/sts/policy/
  // auto-routing.yaml grants its five secrets. Nothing reads it while SECRETS_SOURCE is
  // `secrets-store`.
  "services": [
    { "binding": "BENCHMARK_SERVICE", "service": "auto-routing-benchmark" },
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "auto-routing" },
    },
  ],

  "kv_namespaces": [
    {
      "binding": "AUTO_ROUTING_CONFIG",
      "id": "4316b8db31e347e19cfadad1b6386ad5",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "INTERNAL_API_SECRET_PROD",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "INTERNAL_API_SECRET_PROD",
    },
    {
      "binding": "OPENROUTER_API_KEY",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "OPENROUTER_API_KEY",
    },
    {
      "binding": "O11Y_CF_AE_API_TOKEN",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "O11Y_CF_AE_API_TOKEN",
    },
    {
      "binding": "NEXTAUTH_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "NEXTAUTH_SECRET_PROD",
    },
    {
      // Shared with the gateway, which verifies decision IDs (ADR 0005).
      "binding": "AUTO_ROUTING_DECISION_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "AUTO_ROUTING_DECISION_SECRET_PROD",
    },
  ],
}
