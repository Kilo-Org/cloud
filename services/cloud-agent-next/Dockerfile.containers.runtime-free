FROM docker.io/library/debian:trixie-slim

ARG NODE_VERSION="24.9.0"
ARG BUN_VERSION="1.3.14"
ARG PNPM_VERSION="11.1.2"
ARG GLAB_VERSION="1.93.0"
ARG GH_VERSION="2.82.1"

ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends \
		ca-certificates \
		curl \
		git \
		git-lfs \
		jq \
		libatomic1 \
		locales \
		openssh-client \
		procps \
		ripgrep \
		unzip \
		wget \
		xz-utils; \
	git lfs install --system --skip-repo; \
	sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen; \
	locale-gen; \
	apt-get clean; \
	rm -rf /var/lib/apt/lists/*
ENV LC_ALL=en_US.UTF-8
ENV LANG=en_US.UTF-8

RUN wget -nv -O /tmp/glab.deb "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_amd64.deb" \
	&& dpkg -i /tmp/glab.deb \
	&& rm /tmp/glab.deb

RUN wget -nv -O /tmp/gh.tar.gz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
	&& tar -xzf /tmp/gh.tar.gz -C /tmp \
	&& install -m 0755 "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
	&& rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_amd64"

RUN set -eux; \
	arch="$(dpkg --print-architecture)"; \
	case "$arch" in \
		amd64) node_arch="x64" ;; \
		arm64) node_arch="arm64" ;; \
		*) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
	esac; \
	curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -o /tmp/node.tar.xz; \
	tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
	rm /tmp/node.tar.xz; \
	node --version; \
	npm --version

RUN set -eux; \
	arch="$(dpkg --print-architecture)"; \
	case "$arch" in \
		amd64) bun_arch="x64" ;; \
		arm64) bun_arch="aarch64" ;; \
		*) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
	esac; \
	curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${bun_arch}.zip" -o /tmp/bun.zip; \
	unzip -o /tmp/bun.zip -d /tmp/bun; \
	install -m 0755 "/tmp/bun/bun-linux-${bun_arch}/bun" /usr/local/bin/bun; \
	rm -rf /tmp/bun /tmp/bun.zip; \
	bun --version

RUN npm install -g pnpm@${PNPM_VERSION}

RUN printf '%s\n' \
	'#!/bin/sh' \
	'if [ "$#" -gt 0 ]; then exec "$@"; fi' \
	'exec sleep infinity' \
	> /usr/local/bin/kilo-containers-entrypoint \
	&& chmod +x /usr/local/bin/kilo-containers-entrypoint

ENTRYPOINT ["/usr/local/bin/kilo-containers-entrypoint"]
EXPOSE 3000
