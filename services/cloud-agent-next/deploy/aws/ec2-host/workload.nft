add table inet kilo_workload
flush table inet kilo_workload

table inet kilo_workload {
  set private_v4 {
    type ipv4_addr
    flags interval
    elements = {
      0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10,
      127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
      192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16,
      198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3
    }
  }

  chain proxy_redirect {
    type nat hook prerouting priority -110; policy accept;
    iifname != "docker0" return
    ip saddr != 192.168.251.0/28 return
    ip daddr @private_v4 ip daddr != 198.18.0.1 return
    meta nfproto ipv4 tcp dport 80 redirect to :15080
    meta nfproto ipv4 tcp dport 443 redirect to :15443
  }

  chain workload_to_host {
    type filter hook input priority -200; policy accept;
    iifname != "docker0" return
    ip saddr 192.168.251.0/28 ip daddr 192.168.251.1 udp dport 53 accept
    ip saddr 192.168.251.0/28 ip daddr 192.168.251.1 tcp dport 53 accept
    ip saddr 192.168.251.0/28 ip daddr 192.168.251.1 ct status dnat tcp dport 15080 ct original proto-dst 80 accept
    ip saddr 192.168.251.0/28 ip daddr 192.168.251.1 ct status dnat tcp dport 15443 ct original proto-dst 443 accept
    drop
  }

  chain workload_forward {
    type filter hook forward priority -200; policy accept;
    iifname "docker0" drop
    oifname "docker0" drop
  }
}
