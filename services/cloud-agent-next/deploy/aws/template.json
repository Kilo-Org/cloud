{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Kilo AWS BYOC MVP. Lambda MicroVM sandboxes use an authenticated proxy, restricted DNS and Worker credential exchange.",
  "Metadata": {
    "KiloTemplateVersion": 2
  },
  "Parameters": {
    "KiloRoleArn": {
      "Type": "String",
      "Description": "The fixed Kilo backend role. Do not enter an IAM user ARN.",
      "AllowedPattern": "arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+"
    },
    "ExternalId": {
      "Type": "String",
      "Description": "The owner-bound ExternalId supplied by Kilo.",
      "AllowedPattern": "[A-Za-z0-9_-]{32,128}"
    },
    "RuntimeArtifactBucket": {
      "Type": "String",
      "Description": "Kilo release artifact bucket.",
      "AllowedPattern": "[a-z0-9][a-z0-9-]{1,61}[a-z0-9]"
    },
    "RuntimeArtifactKey": {
      "Type": "String",
      "Description": "Immutable release ZIP containing the runtime image build and hook.",
      "AllowedPattern": "[A-Za-z0-9_./-]+[.]zip"
    },
    "RuntimeRepositoryArn": {
      "Type": "String",
      "Description": "The one ECR repository used by the pinned runtime build.",
      "AllowedPattern": "arn:aws:ecr:[a-z0-9-]+:[0-9]{12}:repository/[a-z0-9_./-]+"
    },
    "ProxyImageUri": {
      "Type": "String",
      "Description": "Immutable AMD64 Kilo egress image in ECR, pinned by digest.",
      "AllowedPattern": "[0-9]{12}[.]dkr[.]ecr[.]us-east-1[.]amazonaws[.]com/[a-z0-9._/-]+@sha256:[a-f0-9]{64}"
    },
    "ProxyRepositoryArn": {
      "Type": "String",
      "Description": "The one ECR repository that contains the egress image.",
      "AllowedPattern": "arn:aws:ecr:us-east-1:[0-9]{12}:repository/[a-z0-9_./-]+"
    },
    "ControlPlaneUrl": {
      "Type": "String",
      "Description": "The HTTPS Kilo Cloud Agent Worker origin. No path, query or credentials.",
      "AllowedPattern": "https://[a-z0-9][a-z0-9.-]*[a-z0-9]"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.84.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.84.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PrivateSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.84.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PublicAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "NatAddress": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "NatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet"
        },
        "AllocationId": {
          "Fn::GetAtt": ["NatAddress", "AllocationId"]
        }
      },
      "DependsOn": "InternetRoute"
    },
    "PrivateRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PrivateAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateSubnet"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutes"
        }
      }
    },
    "NatRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PrivateRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NatGateway"
        }
      }
    },
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireLaunchDocuments",
              "Status": "Enabled",
              "Prefix": "kilo/launch/",
              "ExpirationInDays": 1,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            },
            {
              "Id": "ExpirePreparedArchives",
              "Status": "Enabled",
              "Prefix": "kilo/archives/environments/",
              "ExpirationInDays": 30
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ArtifactPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Artifacts"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": ["Artifacts", "Arn"]
                },
                {
                  "Fn::Sub": "${Artifacts.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/kilo/byoc/${AWS::StackName}"
        },
        "RetentionInDays": 7
      }
    },
    "ConnectorOperatorRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CreateScopedConnectorEni",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ec2:CreateNetworkInterface",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:network-interface/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:subnet/${PrivateSubnet}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:security-group/${SandboxSecurityGroup}"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "ec2:CreateTags",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:network-interface/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "ec2:ManagedResourceOperator": "network-connectors.lambda.amazonaws.com"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "SandboxSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Sandbox egress reaches only the private authenticated proxy",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3128,
            "ToPort": 3128,
            "DestinationSecurityGroupId": {
              "Ref": "ProxyLoadBalancerSecurityGroup"
            }
          }
        ]
      }
    },
    "Connector": {
      "Type": "AWS::Lambda::NetworkConnector",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-sandboxes"
        },
        "OperatorRole": {
          "Fn::GetAtt": ["ConnectorOperatorRole", "Arn"]
        },
        "Configuration": {
          "VpcEgressConfiguration": {
            "AssociatedComputeResourceTypes": ["MicroVm"],
            "NetworkProtocol": "IPv4",
            "SubnetIds": [
              {
                "Ref": "PrivateSubnet"
              }
            ],
            "SecurityGroupIds": [
              {
                "Ref": "SandboxSecurityGroup"
              }
            ]
          }
        }
      }
    },
    "BuildRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": ["sts:AssumeRole", "sts:TagSession"]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "RuntimeBuildInputs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${RuntimeArtifactBucket}/${RuntimeArtifactKey}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Ref": "RuntimeRepositoryArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": {
                    "Fn::GetAtt": ["Logs", "Arn"]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "RuntimeImage": {
      "Type": "AWS::Lambda::MicrovmImage",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-runtime"
        },
        "BaseImageArn": {
          "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:aws:microvm-image:al2023-1"
        },
        "BaseImageVersion": "3",
        "BuildRoleArn": {
          "Fn::GetAtt": ["BuildRole", "Arn"]
        },
        "Description": "Kilo AWS BYOC runtime protocol 1; AMD64, 8GiB baseline",
        "CodeArtifact": {
          "Uri": {
            "Fn::Sub": "s3://${RuntimeArtifactBucket}/${RuntimeArtifactKey}"
          }
        },
        "CpuConfigurations": [
          {
            "Architecture": "X86_64"
          }
        ],
        "Resources": [
          {
            "MinimumMemoryInMiB": 8192
          }
        ],
        "AdditionalOsCapabilities": ["ALL"],
        "EnvironmentVariables": [],
        "EgressNetworkConnectors": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:aws:network-connector:aws-network-connector:INTERNET_EGRESS"
          }
        ],
        "Logging": {
          "CloudWatch": {
            "LogGroup": {
              "Ref": "Logs"
            },
            "LogStream": "runtime-build"
          }
        },
        "Hooks": {
          "Port": 8080,
          "MicrovmHooks": {
            "Run": "ENABLED",
            "RunTimeoutInSeconds": 60,
            "Terminate": "ENABLED",
            "TerminateTimeoutInSeconds": 10
          },
          "MicrovmImageHooks": {
            "Ready": "ENABLED",
            "ReadyTimeoutInSeconds": 300,
            "Validate": "ENABLED",
            "ValidateTimeoutInSeconds": 60
          }
        }
      }
    },
    "CustomerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "KiloRoleArn"
                }
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "KiloSandboxLifecycle",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:RunMicrovm",
                    "lambda:GetMicrovm",
                    "lambda:TerminateMicrovm",
                    "lambda:GetMicrovmImage",
                    "lambda:GetMicrovmImageVersion"
                  ],
                  "Resource": {
                    "Ref": "RuntimeImage"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "lambda:GetNetworkConnector",
                  "Resource": [
                    {
                      "Fn::GetAtt": ["Connector", "Arn"]
                    },
                    {
                      "Fn::GetAtt": ["Connector", "LatestVersionArn"]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "lambda:PassNetworkConnector",
                  "Resource": [
                    {
                      "Fn::GetAtt": ["Connector", "Arn"]
                    },
                    {
                      "Fn::GetAtt": ["Connector", "LatestVersionArn"]
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:aws:network-connector:aws-network-connector:NO_INGRESS"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
                  "Resource": [
                    {
                      "Fn::Sub": "${Artifacts.Arn}/kilo/launch/*"
                    },
                    {
                      "Fn::Sub": "${Artifacts.Arn}/kilo/archives/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:DescribeStacks",
                  "Resource": {
                    "Ref": "AWS::StackId"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": [
                    {
                      "Fn::Sub": "${Artifacts.Arn}/kilo/proxy/public/deployment.json"
                    },
                    {
                      "Fn::Sub": "${Artifacts.Arn}/kilo/proxy/shared/auth.json"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ProxySecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Egress proxy tasks: upstream HTTPS only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "ProxyLoadBalancerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private proxy listener: sandbox traffic only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3128,
            "ToPort": 3128,
            "DestinationSecurityGroupId": {
              "Ref": "ProxySecurityGroup"
            }
          }
        ]
      }
    },
    "ProxyListenerIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "ProxyLoadBalancerSecurityGroup"
        },
        "SourceSecurityGroupId": {
          "Ref": "SandboxSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3128,
        "ToPort": 3128
      }
    },
    "ProxyTaskIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "ProxySecurityGroup"
        },
        "SourceSecurityGroupId": {
          "Ref": "ProxyLoadBalancerSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3128,
        "ToPort": 3128
      }
    },
    "ProxyCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {}
    },
    "ProxyExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PullProxyAndWriteLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Ref": "ProxyRepositoryArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                  "Resource": {
                    "Fn::GetAtt": ["Logs", "Arn"]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ProxyTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeploymentMaterialOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": ["Artifacts", "Arn"]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetObject", "s3:PutObject"],
                  "Resource": [
                    {
                      "Fn::Sub": "${Artifacts.Arn}/kilo/proxy/private/material.json"
                    },
                    {
                      "Fn::Sub": "${Artifacts.Arn}/kilo/proxy/public/deployment.json"
                    },
                    {
                      "Fn::Sub": "${Artifacts.Arn}/kilo/proxy/shared/auth.json"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ProxyTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "RequiresCompatibilities": ["FARGATE"],
        "NetworkMode": "awsvpc",
        "Cpu": "512",
        "Memory": "1024",
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": ["ProxyExecutionRole", "Arn"]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": ["ProxyTaskRole", "Arn"]
        },
        "ContainerDefinitions": [
          {
            "Name": "egress",
            "Image": {
              "Ref": "ProxyImageUri"
            },
            "Essential": true,
            "ReadonlyRootFilesystem": true,
            "PortMappings": [
              {
                "ContainerPort": 3128,
                "Protocol": "tcp"
              }
            ],
            "LinuxParameters": {
              "InitProcessEnabled": true,
              "Capabilities": {
                "Drop": ["ALL"]
              }
            },
            "Ulimits": [
              {
                "Name": "nofile",
                "SoftLimit": 2048,
                "HardLimit": 2048
              }
            ],
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "AWS_STACK_ID",
                "Value": {
                  "Ref": "AWS::StackId"
                }
              },
              {
                "Name": "AWS_ARTIFACT_BUCKET",
                "Value": {
                  "Ref": "Artifacts"
                }
              },
              {
                "Name": "PROXY_HOSTNAME",
                "Value": "egress.kilo.internal"
              },
              {
                "Name": "KILO_CONTROL_PLANE_URL",
                "Value": {
                  "Ref": "ControlPlaneUrl"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "egress"
              }
            },
            "MountPoints": [
              {
                "SourceVolume": "temporary",
                "ContainerPath": "/tmp",
                "ReadOnly": false
              }
            ]
          }
        ],
        "Volumes": [
          {
            "Name": "temporary"
          }
        ]
      }
    },
    "ProxyLoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Type": "network",
        "Scheme": "internal",
        "IpAddressType": "ipv4",
        "Subnets": [
          {
            "Ref": "PrivateSubnet"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "ProxyLoadBalancerSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "load_balancing.cross_zone.enabled",
            "Value": "true"
          }
        ]
      }
    },
    "ProxyTargets": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 3128,
        "Protocol": "TCP",
        "TargetType": "ip",
        "HealthCheckProtocol": "HTTP",
        "HealthCheckPath": "/health",
        "HealthCheckPort": "traffic-port",
        "HealthCheckIntervalSeconds": 10,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 2,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "15"
          },
          {
            "Key": "preserve_client_ip.enabled",
            "Value": "false"
          }
        ]
      }
    },
    "ProxyListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "ProxyLoadBalancer"
        },
        "Port": 3128,
        "Protocol": "TCP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "ProxyTargets"
            }
          }
        ]
      }
    },
    "ProxyService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "ProxyCluster"
        },
        "TaskDefinition": {
          "Ref": "ProxyTask"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DesiredCount": 2,
        "EnableExecuteCommand": false,
        "HealthCheckGracePeriodSeconds": 60,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              {
                "Ref": "PrivateSubnet"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "ProxySecurityGroup"
              }
            ],
            "AssignPublicIp": "DISABLED"
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "egress",
            "ContainerPort": 3128,
            "TargetGroupArn": {
              "Ref": "ProxyTargets"
            }
          }
        ]
      },
      "DependsOn": ["ProxyListener", "ProxyTaskIngress", "ProxyListenerIngress", "NatRoute"]
    },
    "ProxyZone": {
      "Type": "AWS::Route53::HostedZone",
      "Properties": {
        "Name": "kilo.internal",
        "VPCs": [
          {
            "VPCId": {
              "Ref": "Vpc"
            },
            "VPCRegion": {
              "Ref": "AWS::Region"
            }
          }
        ]
      }
    },
    "ProxyDns": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "ProxyZone"
        },
        "Name": "egress.kilo.internal",
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": ["ProxyLoadBalancer", "DNSName"]
          },
          "HostedZoneId": {
            "Fn::GetAtt": ["ProxyLoadBalancer", "CanonicalHostedZoneID"]
          },
          "EvaluateTargetHealth": true
        }
      }
    },
    "BootstrapDnsDomains": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Domains": [
          "egress.kilo.internal",
          {
            "Fn::Select": [
              0,
              {
                "Fn::Split": [
                  "/",
                  {
                    "Ref": "ProxyImageUri"
                  }
                ]
              }
            ]
          },
          {
            "Fn::Sub": "api.ecr.${AWS::Region}.amazonaws.com"
          },
          {
            "Fn::Sub": "prod-${AWS::Region}-starport-layer-bucket.s3.${AWS::Region}.amazonaws.com"
          },
          {
            "Fn::Sub": "s3.${AWS::Region}.amazonaws.com"
          },
          {
            "Fn::Sub": "${Artifacts}.s3.${AWS::Region}.amazonaws.com"
          },
          {
            "Fn::Sub": "logs.${AWS::Region}.amazonaws.com"
          }
        ]
      }
    },
    "AllDnsDomains": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Domains": ["*"]
      }
    },
    "DnsRules": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroup",
      "Properties": {
        "FirewallRules": [
          {
            "Action": "ALLOW",
            "Priority": 100,
            "FirewallDomainListId": {
              "Ref": "BootstrapDnsDomains"
            },
            "FirewallDomainRedirectionAction": "TRUST_REDIRECTION_DOMAIN"
          },
          {
            "Action": "BLOCK",
            "Priority": 200,
            "FirewallDomainListId": {
              "Ref": "AllDnsDomains"
            },
            "BlockResponse": "NODATA"
          }
        ]
      }
    },
    "DnsFirewall": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroupAssociation",
      "Properties": {
        "FirewallRuleGroupId": {
          "Ref": "DnsRules"
        },
        "VpcId": {
          "Ref": "Vpc"
        },
        "Priority": 101,
        "MutationProtection": "DISABLED"
      }
    }
  },
  "Outputs": {
    "TemplateVersion": {
      "Value": "2"
    },
    "ProxyProtocolVersion": {
      "Value": "1"
    },
    "RoleArn": {
      "Value": {
        "Fn::GetAtt": ["CustomerRole", "Arn"]
      }
    },
    "Bucket": {
      "Value": {
        "Ref": "Artifacts"
      }
    },
    "ImageArn": {
      "Value": {
        "Ref": "RuntimeImage"
      }
    },
    "ImageVersion": {
      "Value": {
        "Fn::GetAtt": ["RuntimeImage", "LatestActiveImageVersion"]
      }
    },
    "ConnectorArn": {
      "Value": {
        "Fn::GetAtt": ["Connector", "LatestVersionArn"]
      }
    },
    "Vpc": {
      "Value": {
        "Ref": "Vpc"
      }
    },
    "PrivateSubnet": {
      "Value": {
        "Ref": "PrivateSubnet"
      }
    },
    "SandboxSecurityGroup": {
      "Value": {
        "Ref": "SandboxSecurityGroup"
      }
    },
    "ProxyHostname": {
      "Value": "egress.kilo.internal"
    },
    "ProxyService": {
      "Value": {
        "Ref": "ProxyService"
      }
    },
    "ProxyCluster": {
      "Value": {
        "Ref": "ProxyCluster"
      }
    },
    "ProxyLoadBalancerArn": {
      "Value": {
        "Ref": "ProxyLoadBalancer"
      }
    }
  }
}
