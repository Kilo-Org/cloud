#!/bin/sh
set -eu

case "${1:-}" in
get) ;;
*) exit 0 ;;
esac

protocol=
host=
query_path=
while IFS= read -r line || [ -n "$line" ]; do
	[ -z "$line" ] && break
	case "$line" in
	protocol=*) protocol="${line#protocol=}" ;;
	host=*) host="${line#host=}" ;;
	path=*) query_path="${line#path=}" ;;
	esac
done

[ "$protocol" = https ] || exit 0

# A session writes one pathless record for each host: the alias is the same for
# every repository of a host, and the proxy tells repositories apart by the
# request path. Git sends `path=` only when `credential.useHttpPath` is true,
# which the pinned configuration keeps false. The environment builder holds a
# real token for each repository, so it writes one path-qualified record for
# each repository and turns `useHttpPath` on for its own processes. A pathless
# query only matches a pathless record, and a query with a path only matches a
# record with that path.
normalize_path() {
	printf '%s' "${1%.git}"
}

session_home="${SESSION_HOME:-${HOME:-}}"
if [ -n "$session_home" ]; then
	credential_file="$session_home/.local/share/kilo/cloud-agent/git-credentials"
	if [ -f "$credential_file" ]; then
		# Records are separated by a blank line; each is
		# protocol=, host=, username=, password=, and optionally path=.
		host_matches=0
		full_matches=0
		matched_username=
		matched_password=

		r_protocol=
		r_host=
		r_path=
		r_username=
		r_password=
		r_malformed=0
		r_fields=0

		reset_record() {
			r_protocol=
			r_host=
			r_path=
			r_username=
			r_password=
			r_malformed=0
			r_fields=0
		}

		evaluate_record() {
			[ -n "$r_host" ] || return 0
			[ "$r_host" = "$host" ] || return 0
			# A record for this host is authoritative: a malformed or
			# incomplete one must fail closed, never fall back.
			host_matches=$((host_matches + 1))
			[ "$r_malformed" -eq 0 ] || return 0
			[ "$r_fields" -eq 4 ] || [ "$r_fields" -eq 5 ] || return 0
			[ "$r_protocol" = "$protocol" ] || return 0
			if [ -n "$query_path" ]; then
				[ "$(normalize_path "$r_path")" = "$(normalize_path "$query_path")" ] || return 0
			else
				[ -z "$r_path" ] || return 0
			fi
			[ -n "$r_username" ] || return 0
			[ -n "$r_password" ] || return 0
			full_matches=$((full_matches + 1))
			matched_username="$r_username"
			matched_password="$r_password"
		}

		while IFS= read -r line || [ -n "$line" ]; do
			if [ -z "$line" ]; then
				evaluate_record
				reset_record
				continue
			fi
			r_fields=$((r_fields + 1))
			case "$line" in
			protocol=*) r_protocol="${line#protocol=}" ;;
			host=*) r_host="${line#host=}" ;;
			path=*) r_path="${line#path=}" ;;
			username=*) r_username="${line#username=}" ;;
			password=*) r_password="${line#password=}" ;;
			*) r_malformed=1 ;;
			esac
		done < "$credential_file"
		if [ "$r_fields" -gt 0 ]; then
			evaluate_record
		fi

		if [ "$full_matches" -eq 1 ]; then
			printf 'username=%s\npassword=%s\n' "$matched_username" "$matched_password"
			exit 0
		fi
		if [ "$host_matches" -gt 0 ]; then
			# A record for this host exists but does not answer this query
			# (an ambiguous pathless query, or an unknown path). Never fall
			# back to an environment token the record set did not intend.
			exit 0
		fi
	fi
fi

username=
password=

case "$host" in
github.com)
	username=x-access-token
	password="${GH_TOKEN:-}"
	;;
bitbucket.org)
	username=x-token-auth
	password="${BITBUCKET_TOKEN:-}"
	;;
*)
	gitlab_host="${GITLAB_HOST:-gitlab.com}"
	gitlab_host="${gitlab_host#https://}"
	gitlab_host="${gitlab_host#http://}"
	gitlab_host="${gitlab_host%%/*}"
	if [ "$host" = "$gitlab_host" ]; then
		username=oauth2
		password="${GITLAB_TOKEN:-}"
	fi
	;;
esac

[ -n "$password" ] || exit 0

printf 'username=%s\npassword=%s\n' "$username" "$password"
