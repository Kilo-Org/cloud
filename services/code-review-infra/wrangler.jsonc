{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "name": "kilo-code-review-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-20",
  // The review routes verify STS tokens with jose (@kilocode/verify); before 2026-03-03 this flag
  // keeps a caught verification failure from surfacing as an unhandled rejection (panva/jose#892).
  "compatibility_flags": ["nodejs_compat", "unhandled_rejection_after_microtask_checkpoint"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
    // (services/sts/test/repo/worker-configs.ts).
    "traces": { "enabled": false },
  },
  "logpush": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  // Public environment variables
  "vars": {
    "ENVIRONMENT": "production",
    "API_URL": "https://app.kilo.ai",
    "CLOUD_AGENT_NEXT_URL": "https://cloud-agent-next.kilosessions.ai",
    // Where every runtime secret read goes: `secrets-store` (the Worker secrets set with
    // `wrangler secret put`) or `sts` (the bundle over the `STS` binding). An absent value means
    // `secrets-store`; any other value refuses every read. The `sts` source never falls back to
    // the legacy binding.
    "SECRETS_SOURCE": "secrets-store",
    // CODE_REVIEW_STATUS_CALLBACK_AUTH is unset (legacy): set `sts` only once the web route accepts
    // the status-write token (README, "Status writes").
    // BACKEND_CREDENTIAL_ACCEPT is unset, which means `legacy-only`: the review routes accept only
    // web's BACKEND_AUTH_TOKEN bearer, exactly as before (src/backend-auth.ts). Accepting STS
    // tokens needs the `code-review:review.*` scopes registered and granted to `web`, then a
    // separate change that sets it and STS_ENVIRONMENT `production`. Rollback is a redeploy with it
    // unset or `legacy-only` (README, "Review route credentials").
  },
  "services": [
    // STS serves both entry points over the account-internal binding. `props.caller` is what STS
    // authorizes on and must equal this Worker's top-level name; services/sts/policy/
    // kilo-code-review-worker.yaml grants INTERNAL_API_SECRET, CALLBACK_TOKEN_SECRET and
    // BACKEND_AUTH_TOKEN. The bundle is not read while SECRETS_SOURCE is `secrets-store`; the
    // status-write token is minted over this binding whenever CODE_REVIEW_STATUS_CALLBACK_AUTH is
    // `sts`, and until the registry PR adds the grant that mint fails as denied (unknown_scope).
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "kilo-code-review-worker" },
    },
  ],
  // Durable Objects configuration
  "durable_objects": {
    "bindings": [
      {
        "name": "CODE_REVIEW_ORCHESTRATOR",
        "class_name": "CodeReviewOrchestrator",
        "script_name": "kilo-code-review-worker",
      },
    ],
  },
  "dev": {
    "port": 8789,
    "local_protocol": "http",
  },
  // Migrations for Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodeReviewOrchestrator"],
    },
  ],
}
