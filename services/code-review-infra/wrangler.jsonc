{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "name": "kilo-code-review-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-20",
  "compatibility_flags": ["nodejs_compat"],
  // Production features. Traces stay off: a config that binds STS may not record traces
  // (services/sts README, "Policy"), since a trace records outbound URLs.
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": false },
  },
  "logpush": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  // Mints this Worker's own status-write token (src/status-callback-auth.ts).
  "services": [
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "kilo-code-review-worker" },
    },
  ],
  // Public environment variables
  "vars": {
    "ENVIRONMENT": "production",
    "API_URL": "https://app.kilo.ai",
    "CLOUD_AGENT_NEXT_URL": "https://cloud-agent-next.kilosessions.ai",
    // D59: STS by default; rollback is `legacy` (the derived X-Callback-Token).
    "CODE_REVIEW_STATUS_CALLBACK_AUTH": "sts",
  },
  // Durable Objects configuration
  "durable_objects": {
    "bindings": [
      {
        "name": "CODE_REVIEW_ORCHESTRATOR",
        "class_name": "CodeReviewOrchestrator",
        "script_name": "kilo-code-review-worker",
      },
    ],
  },
  "dev": {
    "port": 8789,
    "local_protocol": "http",
  },
  // Migrations for Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodeReviewOrchestrator"],
    },
  ],
}
