{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "container-usage-meter",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": true,
  "placement": { "mode": "smart" },
  "dev": {
    "port": 8813,
    "local_protocol": "http",
    "ip": "0.0.0.0",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
    // (services/sts/test/repo/worker-configs.ts).
    "traces": { "enabled": false },
  },
  "vars": {
    "KILOCODE_BACKEND_BASE_URL": "https://api.kilo.ai",
    "CONTAINER_BILLING_SERVICES": "cloud-agent-next",
    "CONTAINER_BILLING_USER_IDS": "",
    "CONTAINER_BILLING_ORG_IDS": "",
    "CONTAINER_BILLING_CLOUD_AGENT_ORG_IDS": "9d278969-5453-4ae3-a51f-a8d2274a7b56",
    "CONTAINER_BILLING_WARN_REMAINING_MICRODOLLARS": "10000000",
    // Where every runtime secret read goes: `env` (the Secrets Store binding below) or `sts` (the
    // bundle over the `STS` binding). An absent value means `env`; any other value refuses every
    // read. The `sts` source never falls back to the Secrets Store.
    "SECRETS_SOURCE": "env",
  },
  // CONTAINER_BILLING_CLOUD_AGENT_USER_IDS (personal Cloud Agent payers) is a
  // Worker secret, not a checked-in var. Both Cloud Agent payer lists are
  // validated together: a deploy without the secret leaves every Cloud Agent
  // payer in shadow mode. Merging to main deploys this Worker, and `wrangler
  // secret put` fails while a plain var of the same name exists, so moving
  // another var to a secret follows the order in RUNBOOK.md.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],
  // STS serves the runtime secret bundle over the account-internal binding. `props.caller` is
  // what STS authorizes on and must equal this Worker's top-level name; services/sts/policy/
  // container-usage-meter.yaml grants INTERNAL_API_SECRET. Nothing reads it while SECRETS_SOURCE
  // is `env`.
  "services": [
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "container-usage-meter" },
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "INTERNAL_API_SECRET_PROD",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "INTERNAL_API_SECRET_PROD",
    },
  ],
}
