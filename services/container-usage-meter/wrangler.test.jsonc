{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "container-usage-meter-test",
  "main": "test/test-worker.ts",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat", "service_binding_extra_handlers"],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      {
        "name": "FAILOVER_BUFFER",
        "class_name": "FailoverBufferDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FailoverBufferDO"],
    },
  ],
}
