{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "event-service",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
  // (services/sts/test/repo/worker-configs.ts).
  "observability": { "enabled": true, "traces": { "enabled": false } },
  "logpush": true,
  "placement": { "mode": "smart" },
  "dev": { "port": 8809 },
  "vars": {
    "WORKER_ENV": "production",
    // Where every runtime secret read goes: `env` (the Secrets Store binding below) or `sts` (the
    // bundle over the `STS` binding). An absent value means `env`; any other value refuses every
    // read. The `sts` source never falls back to the Secrets Store.
    "SECRETS_SOURCE": "env",
  },
  "routes": [
    {
      "pattern": "events.kiloapps.io",
      "zone_name": "kiloapps.io",
      "custom_domain": true,
    },
  ],

  "durable_objects": {
    "bindings": [
      { "name": "USER_SESSION_DO", "class_name": "UserSessionDO" },
      { "name": "CONNECTION_TICKET_DO", "class_name": "ConnectionTicketDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserSessionDO"] },
    { "tag": "v2", "new_sqlite_classes": ["TicketDO"] },
    { "tag": "v3", "deleted_classes": ["TicketDO"] },
    { "tag": "v4", "new_sqlite_classes": ["ConnectionTicketDO"] },
  ],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],

  // STS serves the runtime secret bundle over the account-internal binding. `props.caller` is
  // what STS authorizes on and must equal this Worker's top-level name; services/sts/policy/
  // event-service.yaml grants NEXTAUTH_SECRET. Nothing reads it while SECRETS_SOURCE is `env`.
  "services": [
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "event-service" },
    },
  ],

  "secrets_store_secrets": [
    {
      "binding": "NEXTAUTH_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "NEXTAUTH_SECRET_PROD",
    },
  ],
}
