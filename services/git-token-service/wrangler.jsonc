{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "name": "git-token-service",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat", "enhanced_error_serialization"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "git-token-service.kilosessions.ai",
      "zone_name": "kilosessions.ai",
      "custom_domain": true,
    },
  ],
  "vars": {
    "GITHUB_APP_SLUG": "kiloconnect",
    "GITHUB_APP_BOT_USER_ID": "240665456",
    "GITHUB_LITE_APP_SLUG": "kiloconnect-lite",
    "GITHUB_LITE_APP_BOT_USER_ID": "257753004",
    // Where every runtime secret read goes: `secrets-store` (the Secrets Store binding and legacy
    // Worker secrets below) or `sts` (the bundle over the `STS` binding). An absent value means
    // `secrets-store`; any other value refuses every read. The `sts` source never falls back to
    // the legacy source.
    "SECRETS_SOURCE": "secrets-store",
  },
  "observability": {
    "enabled": true,
    // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
    // (services/sts/test/repo/worker-configs.ts).
    "traces": { "enabled": false },
  },
  "kv_namespaces": [
    {
      "binding": "TOKEN_CACHE",
      // Reuse the existing token cache from cloud-agent
      "id": "ab4d777d134a43248639044613ea29ef",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],
  // STS serves the runtime secret bundle over the account-internal binding. `props.caller` is
  // what STS authorizes on and must equal this Worker's top-level name; services/sts/policy/
  // git-token-service.yaml grants every credential below. Nothing reads it while SECRETS_SOURCE is
  // `secrets-store`.
  "services": [
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "git-token-service" },
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "NEXTAUTH_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "NEXTAUTH_SECRET_PROD",
    },
    {
      "binding": "SCM_SESSION_CAPABILITY_ENCRYPTION_KEY",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "SCM_SESSION_CAPABILITY_ENCRYPTION_KEY_PROD",
    },
    {
      "binding": "BITBUCKET_CLIENT_ID",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "BITBUCKET_CLIENT_ID_PROD",
    },
    {
      "binding": "BITBUCKET_CLIENT_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "BITBUCKET_CLIENT_SECRET_PROD",
    },
    {
      "binding": "BITBUCKET_OAUTH_CREDENTIAL_ACTIVE_KEY_ID",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "BITBUCKET_OAUTH_CREDENTIAL_ACTIVE_KEY_ID_PROD",
    },
  ],
  "dev": {
    "port": 8802,
  },
  "env": {
    "dev": {
      "name": "git-token-service-dev",
      // Local `wrangler dev` only; never deployed. Closed explicitly so a stray
      // `--env dev` deploy gets no route, workers.dev or preview URL.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "GITHUB_APP_SLUG": "kiloconnect-development",
        "GITHUB_APP_BOT_USER_ID": "242397087",
        "GITHUB_LITE_APP_SLUG": "",
        "GITHUB_LITE_APP_BOT_USER_ID": "",
      },
      "kv_namespaces": [
        {
          "binding": "TOKEN_CACHE",
          "id": "7e0b82f3dd30498490a7ebb11f1d20b9",
        },
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // Not a Hyperdrive resource: keeps the production config off this env.
          // Local dev connects through localConnectionString only.
          "id": "local-only",
          "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "NEXTAUTH_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "NEXTAUTH_SECRET_DEV",
        },
        {
          "binding": "SCM_SESSION_CAPABILITY_ENCRYPTION_KEY",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          // @dev-generate base64 32
          "secret_name": "SCM_SESSION_CAPABILITY_ENCRYPTION_KEY_DEV",
        },
        {
          "binding": "BITBUCKET_CLIENT_ID",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "BITBUCKET_CLIENT_ID_DEV",
        },
        {
          "binding": "BITBUCKET_CLIENT_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "BITBUCKET_CLIENT_SECRET_DEV",
        },
        {
          "binding": "BITBUCKET_OAUTH_CREDENTIAL_ACTIVE_KEY_ID",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "BITBUCKET_OAUTH_CREDENTIAL_ACTIVE_KEY_ID_DEV",
        },
      ],
    },
  },
}
