# /etc/caddy/Caddyfile on the relay host (README, "Deploy").
#
# Caddy terminates TLS for the relay's host name and proxies to the Node service on loopback.
# The certificate comes from Let's Encrypt over TLS-ALPN-01 on port 443, the only public port;
# Caddy renews it on its own. There is no `log` directive in the site on purpose: an access log
# would record request targets and headers. The relay writes its own line per request.
{
	auto_https disable_redirects
	# Caddy's own log (journald) keeps its error lines, such as a failed proxy while the relay is
	# down, but never the request's headers (the caller's STS and GitHub tokens) or its target.
	log default {
		format filter {
			wrap console
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
}

github-relay.kiloapps.io {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	reverse_proxy 127.0.0.1:8080
}
