{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "name": "cloudflare-gmail-push",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 8806 },
  // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
  // (services/sts/test/repo/worker-configs.ts).
  "observability": { "enabled": true, "traces": { "enabled": false } },
  "placement": { "mode": "smart" },
  "routes": [
    {
      "pattern": "kiloclaw-gmail.kiloapps.io",
      "zone_name": "kiloapps.io",
      "custom_domain": true,
    },
  ],
  "vars": {
    // Base URL for OIDC audience construction — the worker appends /push/user/<userId>
    "OIDC_AUDIENCE_BASE": "https://kiloclaw-gmail.kiloapps.io",
    // Where every runtime secret read goes: `env` (the Worker secret and Secrets Store binding
    // below) or `sts` (the bundle over the `STS` binding). An absent value means `env`; any other
    // value refuses every read. The `sts` source never falls back to the legacy binding.
    "SECRETS_SOURCE": "env",
  },
  "services": [
    {
      "binding": "KILOCLAW",
      "service": "kiloclaw",
    },
    // STS serves the runtime secret bundle over the account-internal binding. `props.caller` is
    // what STS authorizes on and must equal this Worker's top-level name; services/sts/policy/
    // cloudflare-gmail-push.yaml grants INTERNAL_API_SECRET. Nothing reads it while
    // SECRETS_SOURCE is `env`.
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "cloudflare-gmail-push" },
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "INTERNAL_API_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "INTERNAL_API_SECRET_PROD",
    },
  ],
  "queues": {
    "producers": [{ "binding": "GMAIL_PUSH_QUEUE", "queue": "gmail-push-notifications" }],
    "consumers": [{ "queue": "gmail-push-notifications", "max_retries": 0 }],
  },
  "durable_objects": {
    "bindings": [{ "name": "IDEMPOTENCY", "class_name": "GmailPushIdempotency" }],
  },
  "migrations": [{ "tag": "v1", "new_classes": ["GmailPushIdempotency"] }],
}
