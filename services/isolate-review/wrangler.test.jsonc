{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kilo-isolate-review-worker-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.txt", "**/*.md"], "fallthrough": true }],
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REVIEW_ISOLATE",
        "class_name": "ReviewIsolate",
      },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReviewIsolate"] }],
  "vars": {
    "ENVIRONMENT": "test",
    "NEXTAUTH_SECRET": "test-nextauth-secret",
    "INTERNAL_API_SECRET": "test-internal-secret",
  },
}
