{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kilo-isolate-review-worker-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.txt", "**/*.md", "**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      {
        "name": "REVIEW_ISOLATE",
        "class_name": "ReviewIsolate",
      },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReviewIsolate"] }],
  "vars": {
    "ENVIRONMENT": "test",
    "HYPERDRIVE": { "connectionString": "postgresql://[disabled-test-database" },
    "NEXTAUTH_SECRET": "test-nextauth-secret",
    "INTERNAL_API_SECRET": "test-internal-secret",
    "KILOCODE_BACKEND_BASE_URL": "https://app.kilo.ai",
    "KILO_GATEWAY_URL": "https://api.kilo.ai/api/openrouter",
  },
}
