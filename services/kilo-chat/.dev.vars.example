# WORKER_ENV — local worker auth must match Kilo JWTs minted by the Next.js dev server.
WORKER_ENV=development

# R2 access key — bound as env.R2_ACCESS_KEY_ID at runtime.
# In production, sourced from Secrets Store secret "R2_ACCESS_KEY_ID_KILOCHAT_MEDIA"
# (store_id 342a86d9e3a94da698e82d0c6e2a36f0). For local dev, set the value below.
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 secret key — bound as env.R2_SECRET_ACCESS_KEY at runtime.
# In production, sourced from Secrets Store secret "R2_SECRET_ACCESS_KEY_KILOCHAT_MEDIA"
# (store_id 342a86d9e3a94da698e82d0c6e2a36f0). For local dev, set the value below.
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
