{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "name": "kilo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Production is reached only through its custom domain, so the OAuth issuer
  // is always https://mcp.kiloapps.io (the issuer is derived by the
  // @cloudflare/workers-oauth-provider from the request URL). The workers.dev
  // URL stays disabled in prod; the `dev` env below keeps its own workers.dev
  // URL.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mcp.kiloapps.io",
      "zone_name": "kiloapps.io",
      "custom_domain": true,
    },
  ],
  "dev": {
    "port": 8815,
    "local_protocol": "http",
    "ip": "0.0.0.0",
  },
  "observability": {
    "enabled": true,
  },

  // Workers AI: query embedding for the semantic half of hybrid search
  // (src/search-knn.ts). The model is pinned in src/embedding.ts.
  "ai": { "binding": "AI" },

  // Pending-authorization state for THIS MCP (the library owns clients, codes,
  // refresh tokens, and revoked jtis in OAUTH_KV) — src/store/oauth-store.ts,
  // DO SQLite via Drizzle. One logical registry, so the store is reached via
  // getByName (single named instance).
  "durable_objects": {
    "bindings": [{ "name": "KILO_MCP_OAUTH_STORE", "class_name": "KiloMcpOAuthStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KiloMcpOAuthStore"] }],

  // KV the OAuth provider library requires (its own client/token/grant state).
  // Wrangler provisions this namespace on the first deploy and inherits the
  // deployed binding on subsequent deploys. Do not use a placeholder id.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],

  // Vectorize: the catalog kNN index. Vector ids are procedure paths; the
  // index is provisioned and populated by scripts/embed-catalog.ts
  // (main-branch merge job + one-time bootstrap, never PR jobs).
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "kilo-mcp-catalog",
    },
  ],

  "vars": {
    "WEB_BASE_URL": "https://app.kilo.ai",
    // Server-side PostHog capture key (src/analytics.ts). It is a worker var,
    // never a client bundle, and it is deliberately absent from the `env.dev`
    // vars below so local/dev runs do not send (the web non-production
    // opt-out convention, apps/web/src/components/PostHogProvider.tsx:52-57).
    "NEXT_PUBLIC_POSTHOG_KEY": "phc_GK2Pxl0HPj5ZPfwhLRjXrtdz8eD7e9MKnXiFrOqnB6z",
  },

  // ============================================
  // DEVELOPMENT ENVIRONMENT
  // Deploy with: wrangler deploy --env dev
  // This creates a SEPARATE worker: kilo-mcp-dev
  // ============================================
  "env": {
    "dev": {
      "name": "kilo-mcp-dev",
      "workers_dev": true,
      "vars": {
        "WEB_BASE_URL": "http://localhost:3000",
      },
      "ai": { "binding": "AI" },
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "kilo-mcp-catalog-dev",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "KILO_MCP_OAUTH_STORE",
            "class_name": "KiloMcpOAuthStore",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["KiloMcpOAuthStore"],
        },
      ],
      // Local dev/tests simulate KV; `wrangler dev` ignores the id. Deploying
      // the dev worker remotely (not done by CI) would need a real dev id.
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
    },
  },
}
