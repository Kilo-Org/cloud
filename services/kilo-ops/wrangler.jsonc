{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "name": "kilo-ops",
  "main": "src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
    // (services/sts/test/repo/worker-configs.ts).
    "traces": { "enabled": false },
  },
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "ops.kiloapps.io/*",
      "zone_name": "kiloapps.io",
    },
  ],
  "workers_dev": false,

  "containers": [
    {
      "class_name": "GrafanaContainer",
      "image": "./container/Dockerfile",
      "max_instances": 10,
      "instance_type": "standard-2",
      "name": "kilo-ops",
    },
  ],

  "durable_objects": {
    "bindings": [{ "name": "GRAFANA_CONTAINER", "class_name": "GrafanaContainer" }],
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GrafanaContainer"],
    },
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "CF_ACCESS_TEAM": "engineering-e11",
    "CF_ACCESS_AUD": "ff0440ec2c45e7188331f1430ddf35d2b11fa408ca9b3a58068b80816a0e1d80",
    "CF_CLICKHOUSE_URL": "https://api.cloudflare.com/client/v4/accounts/e115e769bcdd4c3d66af59d3332cb394/analytics_engine/sql",
    "CF_ACCOUNT_ID": "e115e769bcdd4c3d66af59d3332cb394",
    "GF_SERVER_ROOT_URL": "https://ops.kiloapps.io/",
    // Where every runtime secret read goes: `secrets-store` (the Secrets Store bindings below) or
    // `sts` (the bundle over the `STS` binding). An absent value means `secrets-store`; any other
    // value refuses every read. The `sts` source never falls back to the Secrets Store.
    "SECRETS_SOURCE": "secrets-store",
  },

  // STS serves the runtime secret bundle over the account-internal binding. `props.caller` is what
  // STS authorizes on and must equal this Worker's top-level name; services/sts/policy/kilo-ops.yaml
  // grants CF_ANALYTICS_API_KEY's secret (O11Y_CF_AE_API_TOKEN) and GF_SECRET_KEY. Nothing reads it
  // while SECRETS_SOURCE is `secrets-store`. Wrangler does not carry `services` into an env block,
  // so `deploy --env dev` warns that STS is not on `env.dev`: that is intended, because dev binds no
  // STS and runs the analytics proxy off (see the dev block's secrets comment).
  "services": [
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "kilo-ops" },
    },
  ],

  "secrets_store_secrets": [
    {
      "binding": "CF_ANALYTICS_API_KEY",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "O11Y_CF_AE_API_TOKEN",
    },
    {
      "binding": "GF_SECRET_KEY",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "GF_SECRET_KEY",
    },
  ],

  "dev": {
    "port": 8780,
  },
  "env": {
    "dev": {
      "routes": [],
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": [],
      },
      "vars": {
        "ENVIRONMENT": "development",
        "CF_ACCESS_TEAM": "engineering-e11",
        "CF_ACCESS_AUD": "7f6eda4c0714f6ea2afb74a3f055db65659b67571a913eab42468636a9b8c8be",
        "CF_CLICKHOUSE_URL": "https://api.cloudflare.com/client/v4/accounts/e115e769bcdd4c3d66af59d3332cb394/analytics_engine/sql",
        "CF_ACCOUNT_ID": "e115e769bcdd4c3d66af59d3332cb394",
      },
      "durable_objects": {
        "bindings": [{ "name": "GRAFANA_CONTAINER", "class_name": "GrafanaContainer" }],
      },
      "containers": [
        {
          "class_name": "GrafanaContainer",
          "image": "./container/Dockerfile",
          "max_instances": 10,
          "instance_type": "standard-2",
          "name": "kilo-ops",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "GF_SECRET_KEY",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          // A fresh random Grafana secret key for dev deployments only. The dev block binds no
          // Analytics Engine token: none has been minted for dev, and a non-production block of a
          // config that binds STS reads no production-named store secret
          // (services/sts/test/repo/worker-configs.ts), so dev runs the analytics proxy off and
          // src/worker.ts answers "not configured" for it. Adding a `_DEV` entry and its dev
          // binding turns the proxy back on with no code change.
          "secret_name": "GF_SECRET_KEY_DEV",
        },
      ],
    },
  },
}
