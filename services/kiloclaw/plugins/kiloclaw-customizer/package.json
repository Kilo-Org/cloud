{
  "name": "@kiloclaw/kiloclaw-customizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KiloClaw customization plugin for OpenClaw",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:openclaw --external:openclaw/* --outfile=dist/index.js",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.2"
  }
}
