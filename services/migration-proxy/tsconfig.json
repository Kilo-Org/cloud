{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "drizzle/migrations.d.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "vitest.node.config.ts",
    "vitest.container.config.ts"
  ],
  "exclude": ["node_modules", "container"]
}
