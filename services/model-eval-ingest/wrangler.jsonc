{
  "$schema": "node_modules/wrangler/config-schema.json",
  // NOTE: Base config is PRODUCTION. Use --env dev for development.
  //
  // This worker ingests eval results promoted from the internal
  // bench.s1lv.com dashboard. The bench side signs payloads with an HMAC
  // using MODEL_EVAL_INGEST_SECRET; this worker verifies the signature
  // and writes to the Postgres model_eval_ingest table via Hyperdrive,
  // then recomputes modelStats.benchmarks.kiloBench.
  //
  // See .plans/dashboard-v2.md in the kilo-bench repo for design.
  "name": "cloudflare-model-eval-ingest",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "dev": {
    "port": 8796,
    "local_protocol": "http",
    "ip": "0.0.0.0",
  },
  "observability": {
    "enabled": true,
  },
  "logpush": true,
  "placement": {
    "mode": "smart",
  },
  "vars": {
    "ENVIRONMENT": "production",
  },
  // Postgres access — same Hyperdrive instance as the other workers
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],
  // HMAC secret shared with bench.s1lv.com.
  // Rotate by bumping both sides simultaneously.
  "secrets_store_secrets": [
    {
      "binding": "MODEL_EVAL_INGEST_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "MODEL_EVAL_INGEST_SECRET_PROD",
    },
  ],
  // ============================================
  // DEVELOPMENT ENVIRONMENT
  // wrangler deploy --env dev → cloudflare-model-eval-ingest-dev
  // ============================================
  "env": {
    "dev": {
      "name": "cloudflare-model-eval-ingest-dev",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "development",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "624ec80650dd414199349f4e217ddb10",
          "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "MODEL_EVAL_INGEST_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "MODEL_EVAL_INGEST_SECRET_DEV",
        },
      ],
    },
  },
}
