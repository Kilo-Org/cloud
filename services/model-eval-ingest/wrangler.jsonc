{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Touch this Worker config when a deploy-only PR needs to retrigger model-eval-ingest.
  "name": "model-eval-ingest",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "dev": {
    "port": 8798,
    "local_protocol": "http",
    "ip": "0.0.0.0",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": false,
    },
    // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
    // (services/sts/test/repo/worker-configs.ts).
    "traces": { "enabled": false },
  },
  "logpush": true,
  "vars": {
    "ENVIRONMENT": "production",
    // Where every runtime secret read goes: `secrets-store` (the Secrets Store binding below) or
    // `sts` (the bundle over the `STS` binding). An absent value means `secrets-store`; any other
    // value refuses every read. The `sts` source never falls back to the Secrets Store.
    "SECRETS_SOURCE": "secrets-store",
  },
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],
  // STS serves the runtime secret bundle over the account-internal binding. `props.caller` is
  // what STS authorizes on and must equal this Worker's top-level name; services/sts/policy/
  // model-eval-ingest.yaml grants INTERNAL_API_SECRET. Nothing reads it while SECRETS_SOURCE is
  // `secrets-store`.
  "services": [
    {
      "binding": "BENCH_DASHBOARD",
      "service": "kilo-bench-dashboard",
      "entrypoint": "Dashboard",
    },
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "model-eval-ingest" },
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "INTERNAL_API_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "INTERNAL_API_SECRET_PROD",
    },
  ],
  "env": {
    "dev": {
      "name": "model-eval-ingest-dev",
      "routes": [],
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": [],
      },
      "vars": {
        "ENVIRONMENT": "development",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "local-only",
          "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
        },
      ],
      "services": [
        {
          "binding": "BENCH_DASHBOARD",
          "service": "kilo-bench-dashboard-dev",
          "entrypoint": "Dashboard",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "INTERNAL_API_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "INTERNAL_API_SECRET_DEV",
        },
      ],
    },
  },
}
