# Local worker auth must match Kilo JWTs minted by the Next.js dev server.
WORKER_ENV=development

# @from INTERNAL_SESSION_AUTH_LEGACY_ENABLED
INTERNAL_SESSION_AUTH_LEGACY_ENABLED=true

# Opt-in local dev / E2E push sink mode. When set to "log", the
# NotificationChannelDO records outgoing agent-push payloads (token
# redacted) instead of calling Expo, so simulator E2E can drive the full
# chain to a `dispatched` outcome without a real APNs token. Absent from
# `wrangler.jsonc` (which is single-config production) and default-off.
# Set to `log` here to enable; leave unset / empty to keep the real Expo
# send path.
PUSH_SINK_MODE=

# Base origin of the web app for the internal glanceable-agents-snapshot
# route (see ENVIRONMENT.md). Production pins `https://app.kilo.ai` in
# wrangler.jsonc, which is single-config; the local dev override points the
# worker at the local Next.js server. The snapshot route verifies the
# dedicated GLANCEABLE_SNAPSHOT_SIGNING_SECRET credential. During compatibility,
# the caller also sends the existing internal-secret header for older receivers.
# @url nextjs
KILO_WEB_API_BASE_URL=https://app.kilo.ai
