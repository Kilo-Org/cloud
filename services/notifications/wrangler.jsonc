{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notifications",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat", "unhandled_rejection_after_microtask_checkpoint"],
  "dev": { "port": 8804 },
  "placement": { "mode": "smart" },
  // Traces stay off: a trace records outbound URLs and Durable Object SQL
  // bindings, and a Worker that binds STS records none
  // (services/sts/test/repo/worker-configs.ts).
  "observability": { "enabled": true, "traces": { "enabled": false } },
  // Item 9 internal-auth counter (design section 9.4): no Logpush here, so each
  // `kilo_internal_auth` line also becomes one Analytics Engine data point. `o11y` reads this
  // dataset once a minute and emits the same line to Axiom. At most two writes per bucket per
  // isolate per minute, and never more writes than accepted requests in total.
  "analytics_engine_datasets": [
    { "binding": "INTERNAL_AUTH_COUNTER", "dataset": "kilo_internal_auth" },
  ],
  // Notification history retention. `NotificationsService.scheduled` prunes rows
  // older than the 90-day history window; see
  // src/lib/notification-history-prune.ts.
  "triggers": { "crons": ["41 3 * * *"] },
  "vars": {
    "WORKER_ENV": "production",
    "KILO_WEB_API_BASE_URL": "https://app.kilo.ai",
    // APNs auth for Live Activity push. The topic is the iOS bundle id; the
    // client appends `.push-type.liveactivity`. The team and key ids are public
    // identifiers, so they live here; the .p8 itself is a Secrets Store secret.
    // Until all four values are present the worker logs "credentials missing"
    // and skips Live Activity delivery.
    "APNS_TOPIC": "com.kilocode.kiloapp",
    "APNS_TEAM_ID": "X96D76J65Z",
    "APNS_KEY_ID": "KRYMZL626P",
    // Where every runtime secret read goes: `secrets-store` (the Secrets Store
    // bindings below) or `sts` (the STS bundle over the `STS` binding). An
    // absent value means `secrets-store`; any other value refuses every read.
    // The `sts` source never falls back to the Secrets Store.
    "SECRETS_SOURCE": "secrets-store",
    // One pre-flip check per isolate that the STS copy of the APNs key, the
    // signer and the internal secret equals the Secrets Store value served
    // above (src/secrets-compare.ts). Only `true` turns it on; it never changes
    // the source. Production only: staging does not set it.
    "SECRETS_COMPARE_ENABLED": "true",
  },

  "routes": [
    {
      "pattern": "notifications.kiloapps.io",
      "zone_name": "kiloapps.io",
      "custom_domain": true,
    },
  ],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATION_CHANNEL_DO",
        "class_name": "NotificationChannelDO",
      },
    ],
  },

  "queues": {
    "producers": [
      {
        "binding": "RECEIPTS_QUEUE",
        "queue": "notifications-receipts",
      },
    ],
    "consumers": [
      {
        "queue": "notifications-receipts",
        "max_retries": 3,
        "dead_letter_queue": "notifications-receipts-dlq",
        "retry_delay": 60,
      },
    ],
  },

  "services": [
    {
      "binding": "EVENT_SERVICE",
      "service": "event-service",
    },
    // STS serves the runtime secret bundle over the account-internal binding.
    // `props.caller` is what STS authorizes on and must equal this Worker's
    // top-level name. This config deploys only production, so it binds the
    // production `sts`; services/sts/policy/notifications.yaml grants the four
    // names. While SECRETS_SOURCE is `secrets-store`, every request is served
    // from the Secrets Store; the only reader here is the one background
    // compare per isolate that SECRETS_COMPARE_ENABLED turns on.
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "notifications" },
    },
  ],

  // Secrets Store bindings: the `secrets-store` source reads these. They stay
  // bound while STS reads are proven, so a rollback is one redeploy with
  // SECRETS_SOURCE set to `secrets-store`.
  "secrets_store_secrets": [
    {
      // The APNs .p8 auth key, stored as one line: `pemToDer()` strips every
      // whitespace character, so the newlines the file had are not needed.
      "binding": "APNS_PRIVATE_KEY",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "APNS_PRIVATE_KEY_PROD",
    },
    {
      "binding": "EXPO_ACCESS_TOKEN",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "EXPO_ACCESS_TOKEN",
    },
    {
      "binding": "NEXTAUTH_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "NEXTAUTH_SECRET_PROD",
    },
    {
      "binding": "INTERNAL_API_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "INTERNAL_API_SECRET_PROD",
    },
  ],

  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["NotificationChannelDO"],
    },
  ],

  // The one named environment. Wrangler refuses any other `--env` instead of
  // resolving it to this production config and its bindings.
  //
  // `staging` is closed: push stays off (src/lib/push-gate.ts), it binds no
  // signer, provider credential, internal secret, STS, queue or service, and it
  // has no route or schedule. A request that needs a signer or the internal
  // secret is refused before any database read. Bindings are not inherited, so
  // only the ones listed here exist; the empty lists record that on purpose.
  // The `workers.dev` and preview URL flags pin the script's current settings
  // and add no ingress. src/wrangler-config.node.test.ts asserts both blocks.
  "env": {
    "staging": {
      "name": "notifications-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "triggers": { "crons": [] },
      "vars": {
        "WORKER_ENV": "staging",
        "NOTIFICATIONS_PUSH_ENABLED": "false",
        "SECRETS_SOURCE": "secrets-store",
      },
      // The staging database, cache disabled; never the production config.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "c9c9b6b68684471ba0fcc69fff3673cf",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NOTIFICATION_CHANNEL_DO",
            "class_name": "NotificationChannelDO",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_classes": ["NotificationChannelDO"],
        },
      ],
      "queues": { "producers": [], "consumers": [] },
      "services": [],
      "secrets_store_secrets": [],
    },
  },
}
