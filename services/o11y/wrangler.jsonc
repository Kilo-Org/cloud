/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "o11y",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  // Traces stay off: a fetch span records url.full, and the Slack webhook URL is the secret.
  // https://developers.cloudflare.com/workers/observability/traces/spans-and-attributes/
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false },
  },
  "logpush": true,
  // `@kilocode/verify` verifies JOSE tokens; before 2026-03-03 this flag is not on by default
  // (design section 7). It changes when Workerd reports unhandled rejections, not verification.
  "compatibility_flags": ["nodejs_compat", "unhandled_rejection_after_microtask_checkpoint"],
  "dev": { "port": 8801 },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  "placement": { "mode": "smart" },
  "routes": [
    {
      "pattern": "o11y.kiloapps.io",
      "zone_name": "kiloapps.io",
      "custom_domain": true,
    },
  ],
  /**
   * Cron Triggers — run alert evaluation every minute
   * https://developers.cloudflare.com/workers/configuration/cron-triggers/
   */
  "triggers": {
    "crons": ["* * * * *"],
  },
  /**
   * Analytics Engine — time-series storage for API metrics used by alerting
   * https://developers.cloudflare.com/analytics/analytics-engine/get-started/
   */
  "analytics_engine_datasets": [
    { "binding": "O11Y_API_METRICS", "dataset": "o11y_api_metrics" },
    { "binding": "O11Y_SESSION_METRICS", "dataset": "o11y_session_metrics" },
  ],
  /**
   * Pipelines -- dual-write to R2 as Parquet for Snowflake export.
   * Requires infra setup: see pipelines/ directory for stream schemas;
   * provision the corresponding streams, sinks, and pipelines via wrangler CLI.
   *
   * Changing a stream schema? Streams are immutable, so you must destroy and recreate.
   * Use the helper script (run from cloudflare-o11y/):
   *   ./pipelines/recreate-stream.sh <stream-name> <schema-file> <pipeline-name> <sink-name>
   * e.g.:
   *   ./pipelines/recreate-stream.sh o11y_api_metrics_stream pipelines/api-metrics-schema.json \
   *     o11y_api_metrics_pipeline o11y_api_metrics_sink
   */
  "pipelines": [
    { "stream": "70379355c2d741fc8b4527e69b501f52", "binding": "API_METRICS_STREAM" },
    { "stream": "82c1fc4073bb4830a6670e920b9823c2", "binding": "SESSION_METRICS_STREAM" },
  ],
  /**
   * KV Namespace — stores alert cooldown and lifecycle state
   */
  "kv_namespaces": [{ "binding": "O11Y_ALERT_STATE", "id": "aef43060c5334b9995450a780eea94fb" }],
  /**
   * Service bindings
   * STS serves the runtime secret bundle over the account-internal binding; props.caller is
   * what STS authorizes on and must equal this Worker's top-level name. Every secret read goes
   * through it. o11y deploys only to production, so it binds the production `sts`; `env.local`
   * binds `sts-local`.
   */
  "services": [
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "o11y" },
    },
  ],
  /**
   * Durable Objects — strongly consistent alert config storage
   */
  "durable_objects": {
    "bindings": [{ "name": "ALERT_CONFIG_DO", "class_name": "AlertConfigDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AlertConfigDO"] }],
  /**
   * `ADMIN_CREDENTIAL_ACCEPT` is unset here, which means `legacy-only`: the admin routes accept
   * only X-O11Y-ADMIN-TOKEN, exactly as before (src/admin-middleware.ts). Accepting STS service
   * tokens needs the `o11y` scopes registered and granted, then a separate change that sets it
   * and STS_ENVIRONMENT. Rollback is a redeploy with it unset or `legacy-only`.
   * `API_METRICS_CREDENTIAL_ACCEPT`, also unset, takes the same values for
   * POST /ingest/api-metrics alone and otherwise follows ADMIN_CREDENTIAL_ACCEPT; the alerting
   * routes never read it. Any STS mode on either needs STS_ENVIRONMENT `production` here.
   */
  "vars": {
    "O11Y_CF_ACCOUNT_ID": "e115e769bcdd4c3d66af59d3332cb394",
    "O11Y_API_BASE_URL": "https://api.kilo.ai",
  },
  /**
   * Alert deployment requirements:
   * - O11Y_CF_AE_API_TOKEN needs account Analytics Read access.
   * - O11Y_SLACK_WEBHOOK_TICKET must deliver to #kilo-o11y-alerts. The STS value does. Keep the
   *   old Secrets Store webhook for a deliberate return to the legacy source only.
   */
  /**
   * Secrets Store
   * https://developers.cloudflare.com/workers/configuration/secrets/#secrets-store
   * Every secret read goes through STS. Keep these bindings and values for rollback until
   * separately approved cleanup. Reverting this change restores the reader with
   * SECRETS_SOURCE=sts. Setting it to secrets-store in the reverted reader restores the older
   * ticket webhook and containers token.
   * A store secret itself goes only once its last consumer reads it through STS (design C.5):
   * other Workers also bind O11Y_CF_AE_API_TOKEN, and the web app also reads
   * O11Y_KILO_GATEWAY_CLIENT_SECRET.
   */
  "secrets_store_secrets": [
    {
      "binding": "O11Y_KILO_GATEWAY_CLIENT_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "O11Y_KILO_GATEWAY_CLIENT_SECRET",
    },
    {
      "binding": "O11Y_CF_AE_API_TOKEN",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "O11Y_CF_AE_API_TOKEN",
    },
    {
      "binding": "O11Y_SLACK_WEBHOOK_PAGE",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "O11Y_SLACK_WEBHOOK_PAGE",
    },
    {
      "binding": "O11Y_SLACK_WEBHOOK_TICKET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "O11Y_SLACK_WEBHOOK_TICKET",
    },
    {
      "binding": "O11Y_CF_CONTAINERS_API_TOKEN",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "O11Y_CF_CONTAINERS_API_TOKEN",
    },
  ],
  "env": {
    // Local development only: the `dev` and `start` scripts run
    // `wrangler dev --env local --name o11y`; no deploy workflow targets this name. Bindings are
    // not inherited, so the block repeats each one, and its STS binding targets sts-local, so a
    // local run reads the local broker and never the production one.
    // `pnpm --filter cloudflare-sts dev` serves that broker (services/sts/README.md, "Local
    // development"). `--name o11y` only names the dev session: its registry entry keeps the name
    // the documented session-ingest -> o11y local binding resolves, while this block's own name
    // stays `o11y-local` so a stray `wrangler deploy --env local` cannot target the production
    // Worker. Every resource id is a local placeholder that `wrangler dev` simulates, and the cron
    // is emptied, so such a deploy reaches no production schedule, data or secret.
    "local": {
      "name": "o11y-local",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "triggers": { "crons": [] },
      "analytics_engine_datasets": [
        { "binding": "O11Y_API_METRICS", "dataset": "o11y_api_metrics_local" },
        { "binding": "O11Y_SESSION_METRICS", "dataset": "o11y_session_metrics_local" },
      ],
      "pipelines": [
        { "stream": "o11y-local-api-metrics", "binding": "API_METRICS_STREAM" },
        { "stream": "o11y-local-session-metrics", "binding": "SESSION_METRICS_STREAM" },
      ],
      "kv_namespaces": [{ "binding": "O11Y_ALERT_STATE", "id": "o11y-local-alert-state" }],
      "services": [
        {
          "binding": "STS",
          "service": "sts-local",
          "entrypoint": "SecretsBroker",
          "props": { "caller": "o11y" },
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "ALERT_CONFIG_DO", "class_name": "AlertConfigDO" }],
      },
      "vars": {
        "O11Y_CF_ACCOUNT_ID": "e115e769bcdd4c3d66af59d3332cb394",
        "O11Y_API_BASE_URL": "https://api.kilo.ai",
      },
      // Canonical secret names (design 4.7) in a local placeholder store, never the production
      // one. Nothing reads them: the local run reads sts-local. `pnpm dev:env` still seeds them.
      "secrets_store_secrets": [
        {
          "binding": "O11Y_KILO_GATEWAY_CLIENT_SECRET",
          "store_id": "o11y-local",
          "secret_name": "O11Y_KILO_GATEWAY_CLIENT_SECRET",
        },
        {
          "binding": "O11Y_CF_AE_API_TOKEN",
          "store_id": "o11y-local",
          "secret_name": "O11Y_CF_AE_API_TOKEN",
        },
        {
          "binding": "O11Y_SLACK_WEBHOOK_PAGE",
          "store_id": "o11y-local",
          "secret_name": "O11Y_SLACK_WEBHOOK_PAGE",
        },
        {
          "binding": "O11Y_SLACK_WEBHOOK_TICKET",
          "store_id": "o11y-local",
          "secret_name": "O11Y_SLACK_WEBHOOK_TICKET",
        },
        {
          "binding": "O11Y_CF_CONTAINERS_API_TOKEN",
          "store_id": "o11y-local",
          "secret_name": "O11Y_CF_CONTAINERS_API_TOKEN",
        },
      ],
    },
  },
}
