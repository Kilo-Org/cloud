{
  "name": "cloudflare-scim-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Polls the WorkOS Events API for directory-sync events and logs them",
  "type": "module",
  "scripts": {
    "preinstall": "node ../../scripts/check-pnpm.mjs",
    "deploy:prod": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging",
    "dev": "wrangler dev --env staging",
    "start": "wrangler dev --env staging",
    "types": "wrangler types --include-runtime false",
    "lint": "pnpm -w exec oxlint --config .oxlintrc.json services/scim-sync/src",
    "format": "oxfmt src",
    "format:check": "oxfmt --list-different src",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@workos-inc/node": "catalog:",
    "workers-tagged-logger": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
