{
  "name": "cloudflare-scim-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Polls the WorkOS Events API for directory-sync (SCIM) events and tracks the stream cursor",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "deploy:prod": "wrangler deploy --env=\"\"",
    "deploy:dev": "wrangler deploy --env dev",
    "dev": "wrangler dev --env dev",
    "start": "wrangler dev --env dev",
    "types": "wrangler types --include-runtime false",
    "lint": "pnpm -w exec oxlint --config .oxlintrc.json services/scim-sync/src",
    "format": "oxfmt src",
    "format:check": "oxfmt --list-different src",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.workers.config.ts",
    "test:integration:watch": "vitest --config vitest.workers.config.ts",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@kilocode/worker-utils": "workspace:*",
    "drizzle-orm": "catalog:",
    "workers-tagged-logger": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
