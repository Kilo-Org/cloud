{
  "$schema": "node_modules/wrangler/config-schema.json",
  // NOTE: Base config is for PRODUCTION environment
  // Use --env staging for the staging deployment
  "name": "cloudflare-scim-sync",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  // Capped at the newest date the pinned miniflare/workerd binary supports, so
  // `wrangler dev` runs the same runtime as production. Raise it with the
  // wrangler/miniflare catalog bump.
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat"],
  // No public URL. `/status` reaches the Durable Object, and an unauthenticated
  // caller on a `*.workers.dev` hostname could create the instance and drive
  // billable Durable Object requests. With no `routes` or service binding
  // either, nothing reaches this Worker over HTTP once deployed: use
  // `wrangler dev` locally and read the poll output from Workers Logs.
  "workers_dev": false,
  "dev": {
    "port": 8819,
    "local_protocol": "http",
    "ip": "0.0.0.0",
  },
  "observability": {
    "enabled": true,
  },
  "logpush": true,
  // Watchdog only. The Durable Object reschedules its own alarm after every
  // poll, so this exists to re-arm the chain if it ever dies (an eviction with
  // exhausted alarm retries). `ensureScheduled` is a no-op when an alarm is
  // already set.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  // `vars`, `secrets_store_secrets` and `durable_objects` are not inherited by
  // a named environment, so `env.staging` below restates each one in full.
  // Everything above this line is inherited and must stay environment-neutral.
  "vars": {
    "ENVIRONMENT": "production",
    // Origin of the Kilo app whose `/api/internal/scim/*` endpoints own the
    // writes. This Worker holds no database binding: directory state is
    // applied over REST so the app keeps the advisory locks, the depth check,
    // the soft-delete side effects and the removal tombstone in one place.
    "BACKEND_API_URL": "https://app.kilo.ai",
    // Seconds between polls. Read on every alarm, so a change takes effect on
    // the first tick after deploy. Clamped in code to 10..3600: a sub-second
    // interval would keep the Durable Object from hibernating and bill
    // continuously for its 128 MB allocation.
    "SCIM_POLL_INTERVAL_SECONDS": "60",
    // Optional `after` cursor. Empty omits `after`, and the Events API returns
    // the oldest retained events first, not current ones. Nothing is
    // persisted, so every poll re-reads this value and re-logs the same events
    // until it is changed and redeployed; the last event ID is logged so it
    // can be copied forward.
    "WORKOS_EVENT_CURSOR": "",
  },
  // One key pair per WorkOS environment. The Events API is scoped to whichever
  // WorkOS environment issued the key, so these names are what decide which
  // directory stream a deployment consumes — not `ENVIRONMENT`.
  "secrets_store_secrets": [
    {
      "binding": "WORKOS_API_KEY",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "WORKOS_API_KEY",
    },
    {
      "binding": "WORKOS_CLIENT_ID",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "WORKOS_CLIENT_ID",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCIM_SYNC_DO",
        "class_name": "ScimSyncDO",
      },
    ],
  },
  // SQLite-backed from the start: switching a deployed class's storage backend
  // later is not supported, and this class will need storage.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScimSyncDO"],
    },
  ],
  // ============================================
  // STAGING ENVIRONMENT
  // Deploy with: wrangler deploy --env staging
  //
  // Named `staging` because that is the only non-production value
  // `deploy-workers.yml` passes, and it skips any Worker whose config lacks an
  // `env` of exactly that name. So this environment is what makes the Worker
  // part of the staging rollout; any other name deploys by hand only.
  //
  // It polls the WorkOS *Staging* directory stream and applies to the staging
  // Kilo app. Pointing it at the production WorkOS keys would make two
  // deployments consume one stream, and once the write path lands they would
  // both apply the same events: the cursor is configuration, not a lease.
  // ============================================
  "env": {
    "staging": {
      "name": "cloudflare-scim-sync-staging",
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "staging",
        "BACKEND_API_URL": "https://staging-app.kilo.ai",
        "SCIM_POLL_INTERVAL_SECONDS": "60",
        "WORKOS_EVENT_CURSOR": "",
      },
      "secrets_store_secrets": [
        {
          "binding": "WORKOS_API_KEY",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "WORKOS_API_KEY_STAGING",
        },
        {
          "binding": "WORKOS_CLIENT_ID",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "WORKOS_CLIENT_ID_STAGING",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SCIM_SYNC_DO",
            "class_name": "ScimSyncDO",
          },
        ],
      },
    },
  },
}
