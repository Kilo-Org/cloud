{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-security-sync",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-26",
  "compatibility_flags": ["nodejs_compat", "enhanced_error_serialization"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": false,
    },
    // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
    // (services/sts/test/repo/worker-configs.ts).
    "traces": { "enabled": false },
  },
  "logpush": true,
  "routes": [
    {
      "pattern": "security-sync.kilosessions.ai",
      "zone_name": "kilosessions.ai",
      "custom_domain": true,
    },
  ],
  "dev": {
    "port": 8812,
    "local_protocol": "http",
    "ip": "0.0.0.0",
  },
  "vars": {
    "ENVIRONMENT": "production",
    "MANUAL_SYNC_COMMAND_ROUTING_ENABLED": "true",
    "DISMISS_FINDING_COMMAND_ROUTING_ENABLED": "true",
    "BACKEND_API_URL": "https://app.kilo.ai",
    "SECURITY_NOTIFICATION_MATERIALIZATION_ENABLED": "true",
    "SECURITY_NOTIFICATION_DISPATCH_ENABLED": "true",
    // Where every runtime secret read goes: `env` (the Secrets Store binding below) or `sts`
    // (the bundle over the `STS` binding). An absent value means `env`; any other value refuses
    // every read. The `sts` source never falls back to the legacy binding.
    "SECRETS_SOURCE": "env",
  },
  "triggers": {
    "crons": ["0 */6 * * *", "15 * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "SYNC_QUEUE",
        "queue": "security-sync-jobs",
      },
      {
        "binding": "DISMISS_QUEUE",
        "queue": "security-dismiss-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "security-sync-jobs",
        "max_batch_size": 1,
        "max_retries": 3,
        "max_concurrency": 25,
        "dead_letter_queue": "security-sync-jobs-dlq",
      },
      {
        "queue": "security-dismiss-jobs",
        "max_batch_size": 1,
        "max_retries": 3,
        "max_concurrency": 20,
        "dead_letter_queue": "security-dismiss-jobs-dlq",
      },
    ],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],
  "services": [
    {
      "binding": "GIT_TOKEN_SERVICE",
      "service": "git-token-service",
      "entrypoint": "GitTokenRPCEntrypoint",
    },
    // STS serves the runtime secret bundle over the account-internal binding. `props.caller` is
    // what STS authorizes on and must equal this Worker's top-level name; services/sts/policy/
    // cloudflare-security-sync.yaml grants INTERNAL_API_SECRET. Nothing reads it while
    // SECRETS_SOURCE is `env`.
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "cloudflare-security-sync" },
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "INTERNAL_API_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "INTERNAL_API_SECRET_PROD",
    },
  ],
  "env": {
    "dev": {
      "name": "cloudflare-security-sync-dev",
      "routes": [],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "development",
        "MANUAL_SYNC_COMMAND_ROUTING_ENABLED": "true",
        "DISMISS_FINDING_COMMAND_ROUTING_ENABLED": "true",
        "BACKEND_API_URL": "http://localhost:3000",
        "SECURITY_NOTIFICATION_MATERIALIZATION_ENABLED": "true",
        "SECURITY_NOTIFICATION_DISPATCH_ENABLED": "true",
      },
      "triggers": {
        "crons": [],
      },
      "queues": {
        "producers": [
          {
            "binding": "SYNC_QUEUE",
            "queue": "security-sync-jobs-dev",
          },
          {
            "binding": "DISMISS_QUEUE",
            "queue": "security-dismiss-jobs-dev",
          },
        ],
        "consumers": [
          {
            "queue": "security-sync-jobs-dev",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 10,
            "dead_letter_queue": "security-sync-jobs-dlq-dev",
          },
          {
            "queue": "security-dismiss-jobs-dev",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 20,
            "dead_letter_queue": "security-dismiss-jobs-dlq-dev",
          },
        ],
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "local-only",
          "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
        },
      ],
      "services": [
        {
          "binding": "GIT_TOKEN_SERVICE",
          "service": "git-token-service-dev",
          "entrypoint": "GitTokenRPCEntrypoint",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "INTERNAL_API_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "INTERNAL_API_SECRET_DEV",
        },
      ],
    },
  },
}
