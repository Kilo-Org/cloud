{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-security-sync",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-26",
  "compatibility_flags": ["nodejs_compat", "enhanced_error_serialization"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": false,
    },
    // Traces stay off: a trace records outbound URLs and Durable Object SQL
    // bindings, and a Worker that binds STS records none
    // (services/sts/test/repo/worker-configs.ts). `env.dev` inherits this
    // block. Cloudflare records no traces without `traces.enabled: true`, so
    // this pins the current setting.
    "traces": {
      "enabled": false,
    },
  },
  "logpush": true,
  "routes": [
    {
      "pattern": "security-sync.kilosessions.ai",
      "zone_name": "kilosessions.ai",
      "custom_domain": true,
    },
  ],
  "dev": {
    "port": 8812,
    "local_protocol": "http",
    "ip": "0.0.0.0",
  },
  "vars": {
    "ENVIRONMENT": "production",
    "MANUAL_SYNC_COMMAND_ROUTING_ENABLED": "true",
    "DISMISS_FINDING_COMMAND_ROUTING_ENABLED": "true",
    "BACKEND_API_URL": "https://app.kilo.ai",
    "SECURITY_NOTIFICATION_MATERIALIZATION_ENABLED": "true",
    "SECURITY_NOTIFICATION_DISPATCH_ENABLED": "true",
    // Where every internal API secret read goes (src/secrets.ts):
    // `secrets-store` reads the INTERNAL_API_SECRET binding below, `sts` reads
    // the STS bundle over the `STS` binding and never falls back. An absent
    // value means `secrets-store`; any other value refuses every read.
    "SECRETS_SOURCE": "secrets-store",
  },
  "triggers": {
    "crons": ["0 */6 * * *", "15 * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "SYNC_QUEUE",
        "queue": "security-sync-jobs",
      },
      {
        "binding": "DISMISS_QUEUE",
        "queue": "security-dismiss-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "security-sync-jobs",
        "max_batch_size": 1,
        "max_retries": 3,
        "max_concurrency": 25,
        "dead_letter_queue": "security-sync-jobs-dlq",
      },
      {
        "queue": "security-dismiss-jobs",
        "max_batch_size": 1,
        "max_retries": 3,
        "max_concurrency": 20,
        "dead_letter_queue": "security-dismiss-jobs-dlq",
      },
    ],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],
  "services": [
    {
      "binding": "GIT_TOKEN_SERVICE",
      "service": "git-token-service",
      "entrypoint": "GitTokenRPCEntrypoint",
    },
    // STS serves the runtime secret bundle over the account-internal binding.
    // `props.caller` is what STS authorizes on and must equal this Worker's
    // top-level name. This block deploys production only, so it binds the
    // production `sts`; services/sts/policy/cloudflare-security-sync.yaml
    // grants no name yet. Nothing reads it while SECRETS_SOURCE is
    // `secrets-store`.
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "cloudflare-security-sync" },
    },
  ],
  // The `secrets-store` source reads this binding. It stays bound while STS
  // reads are proven, so a rollback is one redeploy with SECRETS_SOURCE set to
  // `secrets-store`.
  "secrets_store_secrets": [
    {
      "binding": "INTERNAL_API_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "INTERNAL_API_SECRET_PROD",
    },
  ],
  "env": {
    "dev": {
      "name": "cloudflare-security-sync-dev",
      "routes": [],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "development",
        "MANUAL_SYNC_COMMAND_ROUTING_ENABLED": "true",
        "DISMISS_FINDING_COMMAND_ROUTING_ENABLED": "true",
        "BACKEND_API_URL": "http://localhost:3000",
        "SECURITY_NOTIFICATION_MATERIALIZATION_ENABLED": "true",
        "SECURITY_NOTIFICATION_DISPATCH_ENABLED": "true",
      },
      // No schedule outside production: a config that binds STS runs none
      // (services/sts/test/repo/worker-configs.ts), and a deploy of this block
      // would reach the production database through its Hyperdrive id.
      // `wrangler dev` never runs crons by itself and uses the local
      // connection string; trigger a handler by hand, for example
      // `curl "http://127.0.0.1:8812/cdn-cgi/local/scheduled?cron=15+*+*+*+*"`
      // for the notification sweep or `cron=0+*%2F6+*+*+*` for the dispatch.
      "triggers": {
        "crons": [],
      },
      "queues": {
        "producers": [
          {
            "binding": "SYNC_QUEUE",
            "queue": "security-sync-jobs-dev",
          },
          {
            "binding": "DISMISS_QUEUE",
            "queue": "security-dismiss-jobs-dev",
          },
        ],
        "consumers": [
          {
            "queue": "security-sync-jobs-dev",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 10,
            "dead_letter_queue": "security-sync-jobs-dlq-dev",
          },
          {
            "queue": "security-dismiss-jobs-dev",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 20,
            "dead_letter_queue": "security-dismiss-jobs-dlq-dev",
          },
        ],
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "local-only",
          "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
        },
      ],
      "services": [
        {
          "binding": "GIT_TOKEN_SERVICE",
          "service": "git-token-service-dev",
          "entrypoint": "GitTokenRPCEntrypoint",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "INTERNAL_API_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "INTERNAL_API_SECRET_DEV",
        },
      ],
    },
  },
}
