DIRECT_INGEST_PERCENT="0"
DIRECT_INGEST_USER_IDS=""
DIRECT_INGEST_MAX_BYTES="4194304"

# @from INTERNAL_SESSION_AUTH_LEGACY_ENABLED
INTERNAL_SESSION_AUTH_LEGACY_ENABLED=true

# Local session-access invalidation uses the dedicated
# SESSION_INGEST_INVALIDATION_SIGNING_SECRET_PROD Secrets Store value. It must
# match the web app's SESSION_INGEST_INVALIDATION_SIGNING_SECRET. The existing
# internal-secret header is also accepted while compatibility is enabled.
