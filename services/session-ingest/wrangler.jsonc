{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "session-ingest",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-27",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8800,
    "local_protocol": "http",
    "ip": "0.0.0.0",
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
  "placement": {
    "mode": "smart",
  },
  "vars": {
    "DIRECT_INGEST_PERCENT": "100",
    "DIRECT_INGEST_MAX_BYTES": "4194304",
    "SESSION_SHARE_TOKEN_MIN_IAT": "0",
    // Where every runtime secret read goes: `secrets-store` (the Secrets Store binding below) or
    // `sts` (the bundle over the `STS` binding). An absent value means `secrets-store`; any other
    // value refuses every read. The `sts` source never falls back to the Secrets Store.
    "SECRETS_SOURCE": "secrets-store",
  },
  "observability": {
    "enabled": true,
    // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
    // (services/sts/test/repo/worker-configs.ts).
    "traces": { "enabled": false },
  },
  "logpush": true,
  "routes": [
    {
      "pattern": "ingest.kilosessions.ai",
      "zone_name": "kilosessions.ai",
      "custom_domain": true,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "USER_EXISTS_CACHE",
      "id": "ab836697b6034a95beb92aceea474b10",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_INGEST_DO",
        "class_name": "SessionIngestDO",
      },
      {
        "name": "SESSION_ACCESS_CACHE_DO",
        "class_name": "SessionAccessCacheDO",
      },
      {
        "name": "USER_CONNECTION_DO",
        "class_name": "UserConnectionDO",
      },
      {
        "name": "CONNECTION_TICKET_DO",
        "class_name": "ConnectionTicketDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionIngestDO", "SessionAccessCacheDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UserConnectionDO"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ConnectionTicketDO"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "SESSION_INGEST_R2",
      "bucket_name": "session-ingest-staging",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "session-ingest-processing",
      },
    ],
    "consumers": [
      {
        "queue": "session-ingest-processing",
        "max_retries": 3,
        "dead_letter_queue": "session-ingest-dlq",
      },
    ],
  },
  "services": [
    {
      "binding": "O11Y",
      "service": "o11y",
    },
    {
      "binding": "NOTIFICATIONS",
      "service": "notifications",
      "entrypoint": "NotificationsService",
    },
    // STS serves the runtime secret bundle over the account-internal binding. `props.caller` is
    // what STS authorizes on and must equal this Worker's top-level name; services/sts/policy/
    // session-ingest.yaml grants NEXTAUTH_SECRET, INTERNAL_API_SECRET and SESSION_SHARE_JWT_SECRET.
    // Nothing reads it while SECRETS_SOURCE is `secrets-store`.
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "session-ingest" },
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "NEXTAUTH_SECRET_PROD",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "NEXTAUTH_SECRET_PROD",
      // To set: wrangler secrets-store secret create 342a86d9e3a94da698e82d0c6e2a36f0 --name NEXTAUTH_SECRET_PROD --scopes workers
      // docs https://developers.cloudflare.com/workers/wrangler/commands/#secrets-store-secret
    },
    {
      "binding": "INTERNAL_API_SECRET_PROD",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "INTERNAL_API_SECRET_PROD",
    },
    {
      "binding": "SESSION_SHARE_JWT_SECRET_PROD",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      // This Worker both signs and verifies share tokens, so `pnpm dev:env`
      // generates a random local value; no other service reads it.
      // @dev-generate base64 32
      "secret_name": "SESSION_SHARE_JWT_SECRET_PROD",
    },
  ],

  // The one named environment. Wrangler refuses any other `--env` instead of
  // resolving it to this production config and its bindings.
  //
  // `staging` is closed until its own database, bucket, queue, signer and
  // internal secret exist. It binds only the three Durable Object classes the
  // live staging script already has: no Hyperdrive, KV, R2, queue producer or
  // consumer, service, O11Y sink or Secrets Store entry. Bindings are not
  // inherited, so only the ones listed here exist; the empty lists record that
  // on purpose. Those Durable Objects and their alarms can still run against
  // their own storage, but no request, RPC or alarm can reach a database,
  // bucket, queue, service or secret: there is no binding for one.
  // It has no route, no workers.dev or preview URL, no schedule, no Logpush and
  // no Workers Logs, so the old objects' alarm logs (which carry identifiers
  // from the production data they once saw) are not kept while it is closed.
  // The migrations are the live staging lineage, v1-v2, so a deploy applies no
  // Durable Object class change. `ConnectionTicketDO` (v3) is left out: its
  // class is exported but has no namespace or binding here, and the ticket
  // routes refuse without it. src/wrangler-config.test.ts asserts both blocks.
  "env": {
    "staging": {
      "name": "session-ingest-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "triggers": { "crons": [] },
      "logpush": false,
      "observability": { "enabled": false, "traces": { "enabled": false } },
      "vars": {
        "DIRECT_INGEST_PERCENT": "100",
        "DIRECT_INGEST_MAX_BYTES": "4194304",
        "SESSION_SHARE_TOKEN_MIN_IAT": "0",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SESSION_INGEST_DO",
            "class_name": "SessionIngestDO",
          },
          {
            "name": "SESSION_ACCESS_CACHE_DO",
            "class_name": "SessionAccessCacheDO",
          },
          {
            "name": "USER_CONNECTION_DO",
            "class_name": "UserConnectionDO",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["SessionIngestDO", "SessionAccessCacheDO"],
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["UserConnectionDO"],
        },
      ],
      "kv_namespaces": [],
      "hyperdrive": [],
      "r2_buckets": [],
      "queues": { "producers": [], "consumers": [] },
      "services": [],
      "secrets_store_secrets": [],
    },
  },
}
