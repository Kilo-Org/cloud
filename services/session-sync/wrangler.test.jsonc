{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Test configuration for vitest-pool-workers. Every value is local and synthetic.
  "name": "session-sync-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat", "service_binding_extra_handlers"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "NEXTAUTH_SECRET": "nextauth-test-secret-0123456789abcdef",
    "SESSION_SYNC_SECRET": "session-sync-test-secret-0123456789abcdef",
    "INTERNAL_API_SECRET_PROD": "internal-test-secret-0123456789abcdef",
  },
  "ratelimits": [
    {
      "name": "EXCHANGE_IP_LIMITER",
      "namespace_id": "1024",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "EXCHANGE_ACCOUNT_LIMITER",
      "namespace_id": "1025",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "USER_REQUEST_LIMITER",
      "namespace_id": "1026",
      "simple": { "limit": 1200, "period": 60 },
    },
    {
      "name": "USER_BLOB_LIMITER",
      "namespace_id": "1027",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "USER_DATA_BLOCK_LIMITER",
      "namespace_id": "1034",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  // The isolated exchange smoke database. Data-route tests never connect to it.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "session-sync-test",
      "localConnectionString": "postgres://postgres:postgres@localhost:5544/session_sync",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_SYNC_DO",
        "class_name": "SessionSyncDO",
      },
      { "name": "SESSION_SYNC_TENANT_DO", "class_name": "SessionSyncTenantDO" },
      { "name": "SESSION_RELAY_DO", "class_name": "SessionRelayDO" },
      { "name": "SESSION_PRESENCE_DO", "class_name": "SessionPresenceDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionSyncDO"],
    },
    { "tag": "v2", "new_sqlite_classes": ["SessionSyncTenantDO"] },
    { "tag": "v3", "new_sqlite_classes": ["SessionRelayDO", "SessionPresenceDO"] },
  ],
  "r2_buckets": [
    {
      "binding": "SESSION_SYNC_R2",
      "bucket_name": "session-sync-test",
    },
  ],
}
