# Local development secrets — copy to .dev.vars and fill in real values.
# Never commit .dev.vars.

# Bearer token expected by the kilo-deploy-builder worker
BUILDER_AUTH_TOKEN=

# Override to point at a local or staging builder during development
# BUILDER_URL=http://localhost:8804

# Override NEXTAUTH_SECRET for local testing (matches your .env.local)
# NEXTAUTH_SECRET=
