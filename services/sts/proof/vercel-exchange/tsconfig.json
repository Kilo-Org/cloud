{
  // Typecheck only, with the STS workspace's TypeScript and Node types:
  // services/sts/node_modules/.bin/tsc -p services/sts/proof/vercel-exchange/tsconfig.json
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "typeRoots": ["../../node_modules/@types"],
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "lib/**/*.ts", "drive.ts"]
}
