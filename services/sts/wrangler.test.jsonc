{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Test configuration for vitest-pool-workers. Every value is local and synthetic.
  "name": "sts-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
    {
      "type": "Text",
      "globs": ["**/*.yaml"],
      "fallthrough": true,
    },
  ],
  "vars": {
    "STS_ENVIRONMENT": "development",
    "STS_ISSUER": "https://sts.sts-test.invalid",
    "MANAGER_BASE_URL": "https://manager.sts-test.invalid",
    "MANAGER_PROJECT_ID": "test-project-id",
    "MANAGER_ENVIRONMENT_SLUG": "dev",
    "MANAGER_SECRET_PATH": "/runtime",
    "MANAGER_IDENTITY_ID": "test-identity-id",
    "DO_JURISDICTION": "none",
  },
  "queues": {
    "producers": [{ "binding": "AUDIT_QUEUE", "queue": "kilo-audit-local" }],
  },
  "durable_objects": {
    "bindings": [
      { "name": "STS_BUNDLE_DO", "class_name": "BundleDO" },
      { "name": "STS_REFRESHER_DO", "class_name": "RefresherDO" },
      { "name": "STS_SIGNER_DO", "class_name": "SignerDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BundleDO", "RefresherDO", "SignerDO"] }],
}
