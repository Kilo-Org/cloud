{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usage-ingest",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  // Matches the workerd runtime pinned by the repository's Wrangler version.
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "queues": {
    "producers": [{ "binding": "USAGE_INGEST_QUEUE", "queue": "usage-ingest-processing" }],
    "consumers": [{ "queue": "usage-ingest-processing" }],
  },
  "env": {
    "staging": {
      "name": "usage-ingest-staging",
      "workers_dev": true,
      "queues": {
        "producers": [
          { "binding": "USAGE_INGEST_QUEUE", "queue": "usage-ingest-processing-staging" },
        ],
        "consumers": [{ "queue": "usage-ingest-processing-staging" }],
      },
    },
  },
}
