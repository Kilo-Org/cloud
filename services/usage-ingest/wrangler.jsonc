{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usage-ingest",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  // Matches the workerd runtime pinned by the repository's Wrangler version.
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Production merge/deployment prerequisites: eu-queues.md.
  "vars": {
    "USAGE_INGEST_PARALLELISM": "2",
    "USAGE_WRITER_URL": "https://app.kilo.ai/api/internal/usage/record",
    // Direct lane: off | on_stall | first. See README "Direct lane".
    "USAGE_INGEST_DIRECT_MODE": "off",
    "USAGE_INGEST_DIRECT_TIMEOUT_MS": "2000",
    "USAGE_INGEST_STALL_HEDGE_MS": "2000",
  },
  // Approximate and per Cloudflare location, not a fleet-wide limit. Roughly 3x the
  // observed 420/s peak release rate over the shortest allowed period (10 s).
  "ratelimits": [
    {
      "name": "USAGE_DIRECT_LIMITER",
      "namespace_id": "1040",
      "simple": { "limit": 12600, "period": 10 },
    },
  ],
  "queues": {
    "producers": [
      { "binding": "USAGE_INGEST_QUEUE", "queue": "usage-ingest-processing-eu" },
      // Unused by the Worker: exposes the matching DLQ to queue preparation.
      { "binding": "USAGE_INGEST_DLQ", "queue": "usage-ingest-processing-dlq-eu" },
    ],
    "consumers": [
      {
        "queue": "usage-ingest-processing-eu",
        "max_batch_size": 6,
        "max_batch_timeout": 0,
        "max_retries": 20,
        "retry_delay": 60,
        "max_concurrency": 225,
        "dead_letter_queue": "usage-ingest-processing-dlq-eu",
      },
    ],
  },
  "env": {
    "staging": {
      "name": "usage-ingest-staging",
      "workers_dev": true,
      "vars": {
        "USAGE_INGEST_PARALLELISM": "2",
        "USAGE_WRITER_URL": "https://staging-app.kilo.ai/api/internal/usage/record",
        "USAGE_INGEST_DIRECT_MODE": "on_stall",
        "USAGE_INGEST_DIRECT_TIMEOUT_MS": "2000",
        "USAGE_INGEST_STALL_HEDGE_MS": "2000",
      },
      "ratelimits": [
        {
          "name": "USAGE_DIRECT_LIMITER",
          "namespace_id": "1041",
          "simple": { "limit": 12600, "period": 10 },
        },
      ],
      "queues": {
        "producers": [
          { "binding": "USAGE_INGEST_QUEUE", "queue": "usage-ingest-processing-staging-eu" },
          { "binding": "USAGE_INGEST_DLQ", "queue": "usage-ingest-processing-dlq-staging-eu" },
        ],
        "consumers": [
          {
            "queue": "usage-ingest-processing-staging-eu",
            "max_batch_size": 2,
            "max_batch_timeout": 0,
            "max_retries": 20,
            "retry_delay": 60,
            "max_concurrency": 200,
            "dead_letter_queue": "usage-ingest-processing-dlq-staging-eu",
          },
        ],
      },
    },
  },
}
