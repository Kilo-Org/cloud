{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usage-ingest",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  // Matches the workerd runtime pinned by the repository's Wrangler version.
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // env.staging inherits this block. Traces stay off: a config that binds STS may not record
  // traces (services/sts README, "Policy"), since a trace records outbound URLs. Workers Logs
  // stay on. No Logpush: it would ship every billing publish and consume invocation to Axiom; the
  // STS canary's Axiom signal is the web route's log line (README, "STS canary").
  "observability": {
    "enabled": true,
    "traces": { "enabled": false },
  },
  // Item 9 internal-auth counter (design section 9.4): with no Logpush, each `kilo_internal_auth`
  // line also becomes one Analytics Engine data point here. `o11y` reads this dataset once a minute
  // and emits the same line to Axiom. At most two writes per bucket per isolate per minute, and
  // never more writes than accepted requests in total.
  "analytics_engine_datasets": [
    { "binding": "INTERNAL_AUTH_COUNTER", "dataset": "kilo_internal_auth" },
  ],
  // The STS canary (services/usage-ingest README, "STS canary"); env.staging sets its own copy.
  "triggers": { "crons": ["*/5 * * * *"] },
  "services": [
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "usage-ingest" },
    },
  ],
  // Production merge/deployment prerequisites: eu-queues.md.
  "vars": {
    "USAGE_INGEST_PARALLELISM": "2",
    "USAGE_WRITER_URL": "https://app.kilo.ai/api/internal/usage/record",
    // Stall hedge to the global queue: README.md#stall-hedge-to-the-global-queue.
    "USAGE_INGEST_HEDGE_MODE": "on",
    "USAGE_INGEST_HEDGE_DELAY_MS": "1000",
    "USAGE_INGEST_HEDGE_PERCENT": "100",
    // Tagged cutover switch: README.md#cutover-switch. Must not also exist as a Worker secret.
    "USAGE_INGEST_DEDICATED_TAGGED_QUEUE_ENABLED": "true",
    // STS canary switch: exactly "true" runs the 5-minute canary; anything else skips it.
    "STS_CANARY_ENABLED": "true",
    "STS_URL": "https://sts.kiloapps.io",
    // The one `env` claim the STS canary verify route accepts; matches STS_URL's environment.
    "STS_ENVIRONMENT": "production",
    "WEB_STS_CANARY_URL": "https://app.kilo.ai/api/internal/sts-canary",
  },
  "queues": {
    "producers": [
      { "binding": "USAGE_INGEST_QUEUE", "queue": "usage-ingest-processing-eu" },
      // Unused by the Worker: exposes the matching DLQ to queue preparation.
      { "binding": "USAGE_INGEST_DLQ", "queue": "usage-ingest-processing-dlq-eu" },
      { "binding": "USAGE_INGEST_HEDGE_QUEUE", "queue": "usage-ingest-processing" },
      // Enkrypt and Exa fallback usage share a dedicated source, consumer and DLQ; the names predate
      // Exa joining it: README.md#dedicated-tagged-queue-enkrypt-and-exa-fallback.
      { "binding": "USAGE_INGEST_ENKRYPT_QUEUE", "queue": "usage-ingest-enkrypt-eu" },
      // Unused by the Worker: exposes the matching DLQ to queue preparation.
      { "binding": "USAGE_INGEST_ENKRYPT_DLQ", "queue": "usage-ingest-enkrypt-dlq-eu" },
    ],
    "consumers": [
      {
        "queue": "usage-ingest-processing-eu",
        "max_batch_size": 6,
        "max_batch_timeout": 0,
        "max_retries": 20,
        "retry_delay": 60,
        "max_concurrency": 225,
        "dead_letter_queue": "usage-ingest-processing-dlq-eu",
      },
      // Attached regardless of the hedge mode so hedged copies always drain. A DLQ must share
      // its source queue's jurisdiction, so the global queue keeps its global DLQ.
      {
        "queue": "usage-ingest-processing",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 20,
        "retry_delay": 60,
        "max_concurrency": 25,
        "dead_letter_queue": "usage-ingest-processing-dlq",
      },
      // Single-message batches with one cap shared by Enkrypt and Exa fallback: a tagged writer
      // rejection fails only its own invocation and scales only this consumer. A configured
      // ceiling, not measured capacity; the shared writer and database are unchanged.
      {
        "queue": "usage-ingest-enkrypt-eu",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 20,
        "retry_delay": 60,
        "max_concurrency": 50,
        "dead_letter_queue": "usage-ingest-enkrypt-dlq-eu",
      },
    ],
  },
  "env": {
    "staging": {
      "name": "usage-ingest-staging",
      "workers_dev": true,
      "vars": {
        "USAGE_INGEST_PARALLELISM": "2",
        "USAGE_WRITER_URL": "https://staging-app.kilo.ai/api/internal/usage/record",
        "USAGE_INGEST_HEDGE_MODE": "on",
        "USAGE_INGEST_HEDGE_DELAY_MS": "1000",
        "USAGE_INGEST_HEDGE_PERCENT": "100",
        "USAGE_INGEST_DEDICATED_TAGGED_QUEUE_ENABLED": "true",
        "STS_CANARY_ENABLED": "true",
        "STS_URL": "https://sts-staging.kiloapps.io",
        "STS_ENVIRONMENT": "staging",
        "WEB_STS_CANARY_URL": "https://staging-app.kilo.ai/api/internal/sts-canary",
      },
      "triggers": { "crons": ["*/5 * * * *"] },
      "services": [
        {
          "binding": "STS",
          "service": "sts-staging",
          "entrypoint": "SecretsBroker",
          "props": { "caller": "usage-ingest" },
        },
      ],
      "queues": {
        "producers": [
          { "binding": "USAGE_INGEST_QUEUE", "queue": "usage-ingest-processing-staging-eu" },
          { "binding": "USAGE_INGEST_DLQ", "queue": "usage-ingest-processing-dlq-staging-eu" },
          { "binding": "USAGE_INGEST_HEDGE_QUEUE", "queue": "usage-ingest-processing-staging" },
          { "binding": "USAGE_INGEST_ENKRYPT_QUEUE", "queue": "usage-ingest-enkrypt-staging-eu" },
          {
            "binding": "USAGE_INGEST_ENKRYPT_DLQ",
            "queue": "usage-ingest-enkrypt-dlq-staging-eu",
          },
        ],
        "consumers": [
          {
            "queue": "usage-ingest-processing-staging-eu",
            "max_batch_size": 2,
            "max_batch_timeout": 0,
            "max_retries": 20,
            "retry_delay": 60,
            "max_concurrency": 200,
            "dead_letter_queue": "usage-ingest-processing-dlq-staging-eu",
          },
          {
            "queue": "usage-ingest-processing-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 20,
            "retry_delay": 60,
            "max_concurrency": 25,
            "dead_letter_queue": "usage-ingest-processing-dlq-staging",
          },
          {
            "queue": "usage-ingest-enkrypt-staging-eu",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 20,
            "retry_delay": 60,
            "max_concurrency": 10,
            "dead_letter_queue": "usage-ingest-enkrypt-dlq-staging-eu",
          },
        ],
      },
    },
  },
}
