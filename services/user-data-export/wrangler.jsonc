{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "user-data-export",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "port": 8818,
    "local_protocol": "http",
    "ip": "127.0.0.1",
  },
  "limits": {
    "cpu_ms": 300000,
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    // Traces stay off: a trace records outbound URLs, and a Worker that binds STS records none
    // (services/sts/test/repo/worker-configs.ts). The Axiom traces destination carried only
    // spans, so it went with them; logs stay on above.
    "traces": { "enabled": false },
  },
  "logpush": true,
  "routes": [
    {
      "pattern": "user-data-export.kilosessions.ai",
      "zone_name": "kilosessions.ai",
      "custom_domain": true,
    },
  ],
  "vars": {
    "R2_ACCOUNT_ID": "e115e769bcdd4c3d66af59d3332cb394",
    "R2_BUCKET_NAME": "user-data-export",
    "USER_DATA_EXPORT_WEB_URL": "https://api.kilo.ai",
    // Where every runtime secret read goes: `env` (the Worker secrets below) or `sts` (the bundle
    // over the `STS` binding). An absent value means `env`; any other value refuses every read.
    // The `sts` source never falls back to the legacy binding.
    "SECRETS_SOURCE": "env",
  },
  "services": [
    // STS serves the runtime secret bundle over the account-internal binding. `props.caller` is
    // what STS authorizes on and must equal this Worker's top-level name; services/sts/policy/
    // user-data-export.yaml grants INTERNAL_API_SECRET, NEXTAUTH_SECRET and the R2 key pair.
    // Nothing reads it while SECRETS_SOURCE is `env`.
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "user-data-export" },
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "EXPORT_QUEUE",
        "queue": "user-data-export",
      },
    ],
    "consumers": [
      {
        "queue": "user-data-export",
        "max_batch_size": 1,
        "max_retries": 4,
        "retry_delay": 60,
        "max_concurrency": 5,
        "dead_letter_queue": "user-data-export-dlq",
      },
      {
        "queue": "user-data-export-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "EXPORT_BUCKET",
      "bucket_name": "user-data-export",
    },
  ],
  "hyperdrive": [
    {
      "binding": "PRIMARY_STATE_DB",
      "id": "624ec80650dd414199349f4e217ddb10",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
    // Export warehouse: read-only, frozen at its load cutoff. Every source an
    // export reads comes from here, including the identity section, so the whole
    // file reads as of one moment. PRIMARY_STATE_DB above is the job's own state
    // and is never a source.
    // kilo-supabase-snowflake-export, us-east-2. Caching is disabled on the config:
    // every query returns one user's personal data and each row is read once.
    {
      "binding": "EXPORT_WAREHOUSE_DB",
      "id": "c57c7ffa100a424398162dd502bdddce",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/data_export",
    },
  ],
}
