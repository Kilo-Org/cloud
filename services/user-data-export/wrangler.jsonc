{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "user-data-export-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "port": 8818, "local_protocol": "http", "ip": "127.0.0.1" },
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 } },
  "vars": {
    "INTERNAL_API_SECRET": "local-test-only-not-a-secret",
    "R2_ACCESS_KEY_ID": "local-test-access-key",
    "R2_SECRET_ACCESS_KEY": "local-test-secret-key",
    "R2_ACCOUNT_ID": "local-account",
    "R2_BUCKET_NAME": "user-data-export-local",
    "USER_DATA_EXPORT_WEB_URL": "http://127.0.0.1:3000",
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [{ "binding": "EXPORT_QUEUE", "queue": "user-data-export-local" }],
    "consumers": [
      {
        "queue": "user-data-export-local",
        "max_batch_size": 1,
        "max_retries": 4,
        "retry_delay": 60,
        "max_concurrency": 1,
        "dead_letter_queue": "user-data-export-local-dlq",
      },
      {
        "queue": "user-data-export-local-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
      },
    ],
  },
  "r2_buckets": [{ "binding": "EXPORT_BUCKET", "bucket_name": "user-data-export-local" }],
  "hyperdrive": [
    {
      "binding": "PRIMARY_STATE_DB",
      "id": "local-test-only-primary",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
    {
      "binding": "EXPORT_REPLICA_DB",
      "id": "local-test-only-replica",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],
}
