{
  "name": "cloudflare-uts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.dev.jsonc",
    "test": "pnpm run test:workers && pnpm run test:repo && pnpm run test:script",
    "test:workers": "vitest run",
    "test:repo": "vitest run --config vitest.node.config.ts --project repo",
    "test:script": "vitest run --config vitest.node.config.ts --project script",
    "test:postgres": "vitest run --config vitest.node.config.ts --project db",
    "typecheck": "tsgo --noEmit",
    "db:up": "bash scripts/local-db.sh up",
    "db:down": "bash scripts/local-db.sh down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check-access": "tsx scripts/check-platform-access.ts",
    "lint": "pnpm -w exec oxlint --config .oxlintrc.json services/uts/src services/uts/test services/uts/scripts"
  },
  "dependencies": {
    "@kilocode/sts-contracts": "workspace:*",
    "@kilocode/uts-contracts": "workspace:*",
    "@kilocode/verify": "workspace:*",
    "@kilocode/worker-utils": "workspace:*",
    "@simplewebauthn/server": "14.0.1",
    "jose": "catalog:",
    "pg": "8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@typescript/native-preview": "catalog:",
    "playwright": "1.65.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
