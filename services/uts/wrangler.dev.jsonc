{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The UTS mint Worker for local development only: `wrangler dev -c wrangler.dev.jsonc`. Only this
  // config runs the development entry, which adds the local signing route (src/dev.ts). It cannot
  // be deployed: Wrangler runs the build command below before every dev, deploy and version
  // upload, with WRANGLER_COMMAND set to the command, and the command fails unless that is `dev`.
  // The deployed config is wrangler.jsonc.
  "name": "uts-local",
  "main": "src/dev-index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "test \"$WRANGLER_COMMAND\" = dev || { echo 'wrangler.dev.jsonc runs only under wrangler dev; deploy wrangler.jsonc' >&2; exit 1; }",
  },
  "dev": {
    "port": 8800,
    "local_protocol": "http",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false },
  },
  "vars": {
    "UTS_ENVIRONMENT": "development",
    // workerd enforces no data residency, so local development keeps objects unscoped.
    "DO_JURISDICTION": "none",
  },
  "durable_objects": {
    "bindings": [
      { "name": "UTS_SIGNER_DO", "class_name": "UtsSignerDO" },
      { "name": "UTS_KEY_SET_DO", "class_name": "UtsKeySetDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UtsSignerDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UtsKeySetDO"] },
  ],
}
