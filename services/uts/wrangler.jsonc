{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The UTS mint Worker. Top level is production; `wrangler dev --env local` uses the local block.
  "name": "uts",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "port": 8800,
    "local_protocol": "http",
  },
  // The fetch handler runs next to the identity store's primary in Frankfurt (AWS eu-central-1).
  // Placement covers fetch handlers only; the SignerKeys entrypoint (src/signer-keys.ts), which the
  // feed Worker calls for signer keys, runs where the feed Worker runs.
  "placement": { "region": "aws:eu-central-1" },
  // Traces stay off: a trace records Durable Object storage calls and outbound requests, and the
  // signer objects hold private keys. Every env block inherits this.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false },
  },
  "logpush": true,
  "routes": [
    {
      "pattern": "uts.kiloapps.io",
      "zone_name": "kiloapps.io",
      "custom_domain": true,
    },
  ],
  "vars": {
    "UTS_ENVIRONMENT": "production",
    // Signer objects hold private keys, so production and staging pin them to the EU.
    "DO_JURISDICTION": "eu",
  },
  "durable_objects": {
    "bindings": [
      { "name": "UTS_SIGNER_DO", "class_name": "UtsSignerDO" },
      { "name": "UTS_KEY_SET_DO", "class_name": "UtsKeySetDO" },
      { "name": "UTS_AUDIT_RELAY_DO", "class_name": "UtsAuditRelayDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UtsSignerDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UtsKeySetDO"] },
    { "tag": "v3", "new_sqlite_classes": ["UtsAuditRelayDO"] },
  ],
  // The audit outbox relay sends each shard's batches to the environment's UTS audit queue, which
  // services/audit-relay consumes; only UTS produces to it, so the consumer accepts only UTS
  // streams from it (design 8.1).
  "queues": { "producers": [{ "binding": "AUDIT_QUEUE", "queue": "kilo-audit-uts" }] },
  // Every minute: keep the 8 audit shard relays running, maintain audit partitions and OAuth rows,
  // and check relay lag (src/scheduled.ts). It does nothing while IDENTITY_STORE is unbound.
  "triggers": { "crons": ["* * * * *"] },
  // No identity-store Hyperdrive binding yet: the OAuth endpoints and their metadata stay off
  // until the environment's identity store is provisioned (src/grants/binding.ts).
  "env": {
    "staging": {
      "name": "uts-staging",
      "workers_dev": false,
      "placement": { "region": "aws:eu-central-1" },
      "routes": [
        {
          "pattern": "uts-staging.kiloapps.io",
          "zone_name": "kiloapps.io",
          "custom_domain": true,
        },
      ],
      "vars": {
        "UTS_ENVIRONMENT": "staging",
        "DO_JURISDICTION": "eu",
      },
      "durable_objects": {
        "bindings": [
          { "name": "UTS_SIGNER_DO", "class_name": "UtsSignerDO" },
          { "name": "UTS_KEY_SET_DO", "class_name": "UtsKeySetDO" },
          { "name": "UTS_AUDIT_RELAY_DO", "class_name": "UtsAuditRelayDO" },
        ],
      },
      "queues": { "producers": [{ "binding": "AUDIT_QUEUE", "queue": "kilo-audit-uts-staging" }] },
      "triggers": { "crons": ["* * * * *"] },
    },
    // Local development only; no deploy workflow targets this name. Only this block uses the
    // development entry, which adds the local signing route (src/dev.ts).
    "local": {
      "name": "uts-local",
      "main": "src/dev-index.ts",
      "workers_dev": false,
      "routes": [],
      "vars": {
        "UTS_ENVIRONMENT": "development",
        // workerd enforces no data residency, so local development keeps objects unscoped.
        "DO_JURISDICTION": "none",
      },
      "durable_objects": {
        "bindings": [
          { "name": "UTS_SIGNER_DO", "class_name": "UtsSignerDO" },
          { "name": "UTS_KEY_SET_DO", "class_name": "UtsKeySetDO" },
          { "name": "UTS_AUDIT_RELAY_DO", "class_name": "UtsAuditRelayDO" },
        ],
      },
      "queues": { "producers": [{ "binding": "AUDIT_QUEUE", "queue": "kilo-audit-uts-local" }] },
      // No schedule locally; run the cron by hand with `wrangler dev --test-scheduled` and
      // `curl "http://127.0.0.1:8800/__scheduled?cron=*+*+*+*+*"`.
      "triggers": { "crons": [] },
      // The local identity store (`pnpm db:up`). The UTS logins have no password in the repo:
      // set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_IDENTITY_STORE to a URL with the
      // password you gave uts_app_a (README, "Local development").
      "hyperdrive": [
        {
          "binding": "IDENTITY_STORE",
          "id": "uts-local-identity-store",
          "localConnectionString": "postgres://uts_app_a@127.0.0.1:55432/uts",
        },
      ],
    },
  },
}
