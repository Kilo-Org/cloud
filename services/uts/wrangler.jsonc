{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The UTS mint Worker. Top level is production. Local development runs wrangler.dev.jsonc.
  "name": "uts",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The fetch handler runs next to the identity store's primary in Frankfurt (AWS eu-central-1).
  // Placement covers fetch handlers only; the SignerKeys entrypoint (src/signer-keys.ts), which the
  // feed Worker calls for signer keys, runs where the feed Worker runs.
  "placement": { "region": "aws:eu-central-1" },
  // Traces stay off: a trace records Durable Object storage calls and outbound requests, and the
  // signer objects hold private keys. Query strings stay out of the request URLs in logs and
  // traces: a provider callback carries its authorization code there, and a LinkedIn code (no PKCE,
  // no ID-token nonce) read from a log could be replayed while it lives. Every env block inherits
  // this.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false },
    "redact_query_string": true,
  },
  "logpush": true,
  "routes": [
    {
      "pattern": "uts.kiloapps.io",
      "zone_name": "kiloapps.io",
      "custom_domain": true,
    },
  ],
  "vars": {
    "UTS_ENVIRONMENT": "production",
    // Signer objects hold private keys, so production and staging pin them to the EU.
    "DO_JURISDICTION": "eu",
    // The PAT lookup Hyperdrive config's connection limit: 20 percent of max_connections 160. The
    // per-isolate PAT lookup cap is min(100, 3 x this) = 96 (src/env.ts, design 3).
    "PAT_LOOKUP_CONNECTIONS": "32",
    // Passkeys belong to the app host; the sign-in pages on the issuer origin use them as a
    // WebAuthn related origin that the app host lists (design 5.14).
    "WEBAUTHN_RP_ID": "app.kilo.ai",
    "WEBAUTHN_ORIGINS": "https://uts.kiloapps.io",
    // The identity-store login rotation (src/rotation/config.ts) ships off; turning it on here
    // belongs to the later rotation phase, after STS delivers UTS_HYPERDRIVE_SWITCH_TOKEN, the login
    // seeds sit in /db-switch/uts and the origins are pinned (README, "Login rotation").
    "LOGIN_ROTATION": "off",
    // Where the runtime secrets come from (src/secrets.ts): `worker` (the Worker secrets) or `sts`
    // (the UTS STS bundle over the `STS` binding below, never falling back to the Worker secrets).
    // Each environment stays on `worker` until its flip, which is its own change (README, "Runtime
    // secrets"); the Worker secrets stay set either way. The rollback is this one var too, except
    // here while the sign-in client ids below are set: production keeps their client secrets only
    // in the bundle, so they go first.
    "SECRETS_SOURCE": "worker",
    // GitHub, Google, GitLab and LinkedIn sign-in. Production holds their
    // SIGNIN_<PROVIDER>_CLIENT_SECRET values only in its /workloads/uts bundle, never as Worker
    // secrets, so test/repo refuses these client ids until SECRETS_SOURCE above reads `sts`: this
    // change merges only after the flip, and a rollback removes them before the source goes back
    // (README, "Production sign-in providers"). Production sets no Discord client id: that
    // registration and its secret are not ready.
    "SIGNIN_GITHUB_CLIENT_ID": "Ov23lie6u5czgxYlcfcO",
    "SIGNIN_GOOGLE_CLIENT_ID": "1000529458754-3qjv67tvqek9r5q1u8ico35mng699t96.apps.googleusercontent.com",
    "SIGNIN_GITLAB_CLIENT_ID": "1d7b8acf64d4298f8438f0d7019e91c17c205832c19151f73460fc224e1d3f56",
    "SIGNIN_LINKEDIN_CLIENT_ID": "78ip501sirfk5q",
    // Email sign-in and the notice email stay off until UTS_MAILGUN_DOMAIN, UTS_MAIL_FROM and
    // UTS_TURNSTILE_SITE_KEY are added here, after the secrets SIGNIN_EMAIL_HASH_KEY,
    // UTS_MAILGUN_SENDING_KEY and UTS_TURNSTILE_SECRET_KEY are set in the source SECRETS_SOURCE
    // names. Staging also needs UTS_MAIL_ALLOWED_RECIPIENTS; production must not set it (README,
    // "Configuration").
  },
  "durable_objects": {
    "bindings": [
      { "name": "UTS_SIGNER_DO", "class_name": "UtsSignerDO" },
      { "name": "UTS_KEY_SET_DO", "class_name": "UtsKeySetDO" },
      // The two revocation-feed objects; only this Worker binds them (src/feed/UtsFeedDO.ts).
      { "name": "UTS_FEED_DO", "class_name": "UtsFeedDO" },
      { "name": "UTS_AUDIT_RELAY_DO", "class_name": "UtsAuditRelayDO" },
      // The login key of the environment's `uts-rotation-<environment>` identity in the secrets
      // manager; the key set is served at /manager-auth/.well-known/jwks.json (src/dos/UtsManagerAuthDO.ts).
      { "name": "UTS_MANAGER_AUTH_DO", "class_name": "UtsManagerAuthDO" },
      // The identity-store login rotation and its sealed login passwords (src/dos/UtsLoginRotationDO.ts).
      { "name": "UTS_LOGIN_ROTATION_DO", "class_name": "UtsLoginRotationDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UtsSignerDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UtsKeySetDO"] },
    { "tag": "v3", "new_sqlite_classes": ["UtsFeedDO"] },
    { "tag": "v4", "new_sqlite_classes": ["UtsAuditRelayDO"] },
    { "tag": "v5", "new_sqlite_classes": ["UtsManagerAuthDO"] },
    { "tag": "v6", "new_sqlite_classes": ["UtsLoginRotationDO"] },
  ],
  // The audit outbox relay sends each shard's batches to the environment's UTS audit queue, which
  // services/audit-relay consumes; only UTS produces to it, so the consumer accepts only UTS
  // streams from it (design 8.1).
  "queues": { "producers": [{ "binding": "AUDIT_QUEUE", "queue": "kilo-audit-uts" }] },
  // The STS secrets broker as caller `uts` (policy services/sts/policy/uts.yaml): the UTS bundle
  // from /workloads/uts, read for the runtime secrets under SECRETS_SOURCE=sts and for the rotation
  // job's switch token (README, "Runtime secrets" and "Login rotation").
  "services": [
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "uts" },
    },
  ],
  // Every minute: keep the 8 audit shard relays running, maintain audit partitions, OAuth rows and
  // sign-in rows, end long transactions, sweep notices, and check relay lag (src/scheduled.ts).
  "triggers": { "crons": ["* * * * *"] },
  // The identity store's three Hyperdrive configs (README "Deploys"): the primary (logins
  // uts_app_a/b), the PAT lookup config (uts_pat_a/b) and the read replica (uts_reader_a/b).
  // Bindings are not inherited, so the staging block lists its own.
  "hyperdrive": [
    { "binding": "IDENTITY_STORE", "id": "314ea5eee7314e09b59728ff5453e9d9" },
    { "binding": "IDENTITY_STORE_PAT", "id": "f041609cd77043d7b81bdd9265f46cec" },
    { "binding": "IDENTITY_STORE_REPLICA", "id": "4194e3ece2b442e381ec6d82f9bc0dcf" },
  ],
  "env": {
    "staging": {
      "name": "uts-staging",
      "workers_dev": false,
      "placement": { "region": "aws:eu-central-1" },
      "routes": [
        {
          "pattern": "uts-staging.kiloapps.io",
          "zone_name": "kiloapps.io",
          "custom_domain": true,
        },
      ],
      "vars": {
        "UTS_ENVIRONMENT": "staging",
        "DO_JURISDICTION": "eu",
        // The staging PAT lookup config's connection limit; per-isolate cap min(100, 36) = 36.
        "PAT_LOOKUP_CONNECTIONS": "12",
        // Staging keeps its own passkeys on the issuer host, so it needs no related-origins list
        // on the staging app (design 5.14).
        "WEBAUTHN_RP_ID": "uts-staging.kiloapps.io",
        "WEBAUTHN_ORIGINS": "https://uts-staging.kiloapps.io",
        "LOGIN_ROTATION": "off",
        // Staging flips to `sts` in its own change once its STS policy is live and its values match
        // (README, "Runtime secrets").
        "SECRETS_SOURCE": "worker",
        // GitHub, Google, GitLab, Discord and LinkedIn sign-in. Each client id is the switch: its
        // SIGNIN_<PROVIDER>_CLIENT_SECRET is set first, in the staging /workloads/uts bundle and the
        // Worker secret (README, "Configuration"). Production offers GitHub, Google, GitLab and
        // LinkedIn only: Discord stays absent there until its registration and secret are ready.
        "SIGNIN_GITHUB_CLIENT_ID": "Ov23liHukmJusfuEp36F",
        "SIGNIN_GOOGLE_CLIENT_ID": "798264175281-uqim60mc4mnbbecouob37hacetigcaoe.apps.googleusercontent.com",
        "SIGNIN_GITLAB_CLIENT_ID": "60f8aae12a39406cbd5501701e5cf61caef6e9888d9ad71394d1c6c40717694a",
        "SIGNIN_DISCORD_CLIENT_ID": "1575877341895196733",
        "SIGNIN_LINKEDIN_CLIENT_ID": "78mnagua76hqnx",
      },
      "durable_objects": {
        "bindings": [
          { "name": "UTS_SIGNER_DO", "class_name": "UtsSignerDO" },
          { "name": "UTS_KEY_SET_DO", "class_name": "UtsKeySetDO" },
          { "name": "UTS_FEED_DO", "class_name": "UtsFeedDO" },
          { "name": "UTS_AUDIT_RELAY_DO", "class_name": "UtsAuditRelayDO" },
          { "name": "UTS_MANAGER_AUTH_DO", "class_name": "UtsManagerAuthDO" },
          { "name": "UTS_LOGIN_ROTATION_DO", "class_name": "UtsLoginRotationDO" },
        ],
      },
      "queues": { "producers": [{ "binding": "AUDIT_QUEUE", "queue": "kilo-audit-uts-staging" }] },
      "services": [
        {
          "binding": "STS",
          "service": "sts-staging",
          "entrypoint": "SecretsBroker",
          "props": { "caller": "uts" },
        },
      ],
      "triggers": { "crons": ["* * * * *"] },
      "hyperdrive": [
        { "binding": "IDENTITY_STORE", "id": "5dd523ea0fa447ebaf442a0300d8f848" },
        { "binding": "IDENTITY_STORE_PAT", "id": "48227f1c669742618bb7bc6adf9a416c" },
        { "binding": "IDENTITY_STORE_REPLICA", "id": "5fa4d303a52e4274a9750b20e2f507f0" },
      ],
    },
  },
}
