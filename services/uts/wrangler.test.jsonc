{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Test configuration for vitest-pool-workers. Every value is local and synthetic.
  "name": "uts-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": false },
  },
  "vars": {
    "UTS_ENVIRONMENT": "development",
    "DO_JURISDICTION": "none",
  },
  "durable_objects": {
    "bindings": [
      { "name": "UTS_SIGNER_DO", "class_name": "UtsSignerDO" },
      { "name": "UTS_KEY_SET_DO", "class_name": "UtsKeySetDO" },
      { "name": "UTS_AUDIT_RELAY_DO", "class_name": "UtsAuditRelayDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UtsSignerDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UtsKeySetDO"] },
    { "tag": "v3", "new_sqlite_classes": ["UtsAuditRelayDO"] },
  ],
  "queues": { "producers": [{ "binding": "AUDIT_QUEUE", "queue": "kilo-audit-local" }] },
  // The OAuth routes are served once this binding exists. Nothing listens on it: the runtime tests
  // pass their own grant store, and test/db runs every statement against the local Postgres.
  "hyperdrive": [
    {
      "binding": "IDENTITY_STORE",
      "id": "uts-test-identity-store",
      "localConnectionString": "postgres://uts_app_a:unused@127.0.0.1:1/uts",
    },
  ],
  // The mint Worker's SignerKeys entrypoint as the development feed Worker binds it, and as two
  // callers it refuses; and the default entrypoint with the feed Worker's props, which serves no
  // signer keys.
  "services": [
    {
      "binding": "FEED_MINT",
      "service": "uts-test",
      "entrypoint": "SignerKeys",
      "props": { "caller": "uts-feed-local" },
    },
    {
      "binding": "OTHER_MINT",
      "service": "uts-test",
      "entrypoint": "SignerKeys",
      "props": { "caller": "o11y" },
    },
    {
      "binding": "PROPLESS_MINT",
      "service": "uts-test",
      "entrypoint": "SignerKeys",
    },
    {
      "binding": "DEFAULT_MINT",
      "service": "uts-test",
      "props": { "caller": "uts-feed-local" },
    },
  ],
}
