{
  "$schema": "node_modules/wrangler/config-schema.json",
  // NOTE: Base config is for PRODUCTION environment
  // `env.dev` is local-only: run it with `pnpm dev`
  "name": "cloudflare-webhook-agent-ingest",
  "account_id": "e115e769bcdd4c3d66af59d3332cb394",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "dev": {
    "port": 8793,
    "local_protocol": "http",
    "ip": "0.0.0.0",
  },
  // Observability - enables Workers Logs
  "observability": {
    "enabled": true,
    // Traces stay off: a trace records outbound URLs and Durable Object SQL
    // bindings, and a Worker that binds STS records none
    // (services/sts/test/repo/worker-configs.ts). `env.dev` inherits this
    // block. Cloudflare records no traces without `traces.enabled: true`, so
    // this pins the current setting.
    "traces": {
      "enabled": false,
    },
  },
  "logpush": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "routes": [
    {
      "pattern": "hooks.kilosessions.ai",
      "zone_name": "kilosessions.ai",
      "custom_domain": true,
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "KILOCODE_BACKEND_BASE_URL": "https://api.kilo.ai",
    "WEBHOOK_AGENT_URL": "https://hooks.kilosessions.ai",
    "KILOCLAW_API_URL": "https://claw.kilosessions.ai",
    "SHARED_RESOURCE_TOKENS_ENABLED": "true",
    // Where every INTERNAL_API_SECRET, CALLBACK_TOKEN_SECRET and
    // NEXTAUTH_SECRET read goes (src/secrets.ts): `secrets-store` reads the
    // Secrets Store bindings below, `sts` reads the STS bundle over the `STS`
    // binding and never falls back. An absent value means `secrets-store`;
    // any other value refuses every read.
    "SECRETS_SOURCE": "secrets-store",
  },
  // PRODUCTION service binding to Cloud Agent Next
  "services": [
    {
      "binding": "CLOUD_AGENT",
      "service": "cloud-agent-next",
    },
    {
      "binding": "KILO_CHAT",
      "service": "kilo-chat",
      "entrypoint": "KiloChatService",
    },
    // STS serves the runtime secret bundle over the account-internal binding.
    // `props.caller` is what STS authorizes on and must equal this Worker's
    // top-level name. This block deploys production only, so it binds the
    // production `sts`; services/sts/policy/cloudflare-webhook-agent-ingest.yaml
    // grants no name yet. Nothing reads it while SECRETS_SOURCE is
    // `secrets-store`.
    {
      "binding": "STS",
      "service": "sts",
      "entrypoint": "SecretsBroker",
      "props": { "caller": "cloudflare-webhook-agent-ingest" },
    },
  ],
  // PRODUCTION Queue for webhook delivery
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_DELIVERY_QUEUE",
        "queue": "webhook-delivery",
      },
    ],
    "consumers": [
      {
        "queue": "webhook-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
      },
    ],
  },
  // Durable Objects
  "durable_objects": {
    "bindings": [
      {
        "name": "TRIGGER_DO",
        "class_name": "TriggerDO",
      },
    ],
  },
  "kv_namespaces": [
    {
      "binding": "WEBHOOK_TOKEN_CACHE",
      "id": "955e2717898c4ebabfece28a6b107940",
    },
  ],
  // Hyperdrive binding for direct database access (token minting)
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "624ec80650dd414199349f4e217ddb10",
    },
  ],
  // DO migrations
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CatcherDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TriggerDO"],
      "deleted_classes": ["CatcherDO"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [],
    },
  ],
  // PRODUCTION Secrets Store (shared Kilo secrets store). The `secrets-store`
  // source reads these bindings. They stay bound while STS reads are proven,
  // so a rollback is one redeploy with SECRETS_SOURCE set to `secrets-store`.
  "secrets_store_secrets": [
    {
      "binding": "INTERNAL_API_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "INTERNAL_API_SECRET_PROD",
    },
    {
      "binding": "CALLBACK_TOKEN_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "CALLBACK_TOKEN_SECRET_PROD",
    },
    {
      "binding": "NEXTAUTH_SECRET",
      "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
      "secret_name": "NEXTAUTH_SECRET_PROD",
    },
  ],
  // ============================================
  // DEVELOPMENT ENVIRONMENT
  // Local-only: run with `pnpm dev` (wrangler dev). Never deploy it; it has
  // no hosted route, workers.dev URL or schedule, and a local-only database.
  // ============================================
  "env": {
    "dev": {
      "name": "cloudflare-webhook-agent-ingest-dev",
      // Fence: named envs inherit top-level routes; never publish dev to prod hosts.
      "routes": [],
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": [] },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "ENVIRONMENT": "development",
        "KILOCODE_BACKEND_BASE_URL": "http://localhost:3000",
        "KILOCLAW_API_URL": "http://localhost:8795",
        "WEBHOOK_AGENT_URL": "http://localhost:8793",
        "SHARED_RESOURCE_TOKENS_ENABLED": "true",
      },
      // DEV service binding to Cloud Agent Next
      "services": [
        {
          "binding": "CLOUD_AGENT",
          "service": "cloud-agent-next-dev",
        },
        {
          // kilo-chat has no separate dev deployment; kiloclaw does the same.
          "binding": "KILO_CHAT",
          "service": "kilo-chat",
          "entrypoint": "KiloChatService",
        },
      ],
      // DEV Queue (separate from production)
      "queues": {
        "producers": [
          {
            "binding": "WEBHOOK_DELIVERY_QUEUE",
            "queue": "webhook-delivery-dev",
          },
        ],
        "consumers": [
          {
            "queue": "webhook-delivery-dev",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
          },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "TRIGGER_DO",
            "class_name": "TriggerDO",
          },
        ],
      },
      // DEV Secrets Store
      "secrets_store_secrets": [
        {
          "binding": "INTERNAL_API_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "INTERNAL_API_SECRET_DEV",
        },
        {
          "binding": "CALLBACK_TOKEN_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "CALLBACK_TOKEN_SECRET_DEV",
        },
        {
          "binding": "NEXTAUTH_SECRET",
          "store_id": "342a86d9e3a94da698e82d0c6e2a36f0",
          "secret_name": "NEXTAUTH_SECRET_DEV",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "WEBHOOK_TOKEN_CACHE",
          "id": "08db0a0f683a48b0a665c3fb02dc099b",
        },
      ],
      // DEV Hyperdrive binding with local connection string
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "local-only",
          "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
        },
      ],
    },
  },
}
